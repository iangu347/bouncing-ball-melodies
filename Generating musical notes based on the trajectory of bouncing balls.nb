Cell[CellGroupData[{

Cell["Modeling the ball\[CloseCurlyQuote]s trajectory", "Section",
 CellChangeTimes->{{3.929286398542101*^9, 3.929286422755045*^9}, {
  3.929696760679468*^9, 
  3.929696765416664*^9}},ExpressionUUID->"1f869389-77c8-7544-920b-\
d2513a2c6ff7"],

Cell[TextData[{
 "To model the bouncing ball\[CloseCurlyQuote]s trajectory, we can use \
solutions to differential equations. Let ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         RowBox[{
           StyleBox["x", "TI"], 
           RowBox[{"(", 
             StyleBox["t", "TI"], ")"}], ",", 
           StyleBox["y", "TI"], 
           RowBox[{"(", 
             StyleBox["t", "TI"], ")"}], ",", 
           StyleBox["z", "TI"], 
           RowBox[{"(", 
             StyleBox["t", "TI"], ")"}]}], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "(x(t), y(t),z(t))", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e0cb91a2-ca9e-7940-b4b2-2ddf4f56b0f5"],
 " be the position of the ball given time ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["t", "TI"], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> "t.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1bde40ba-0e7a-3f4b-9543-17b47efcb189"],
 " At ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["t", "TI"], "\[LongEqual]", "0", ","}], TraditionalForm], 
     "errors" -> {}, "input" -> "t=0,", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1a1a4fca-56ed-5f4c-b8e7-2b8ad8013188"],
 " let us set the ball to be at position ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           RowBox[{"0", ",", "0.5", ",", 
             SubscriptBox[
              StyleBox["h", "TI"], 
              StyleBox["i", "TI"]]}], ")"}], ","}], TraditionalForm], 
     "errors" -> {}, "input" -> "(0,0.5,h_i),", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "80fcb233-f2bd-a747-befe-c8110bba8c36"],
 " where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["h", "TI"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "h_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "425fdabd-9e43-6d41-b1eb-9f8e8388e188"],
 " is the initial height of the ball. For simplification, we only want the \
ball to have velocity in the x-direction initially, so we set ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["y", "TI"], "\[Prime]"], 
         RowBox[{"(", "0", ")"}], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["z", "TI"], "\[Prime]"], 
         RowBox[{"(", "0", ")"}], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "y'(0)=z'(0)=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5bac14c7-0f01-3846-ac0c-9ab6bbb3187a"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["x", "TI"], "\[Prime]"], 
         RowBox[{"(", "0", ")"}], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["v", "TI"], 
          StyleBox["i", "TI"]], ","}], TraditionalForm], "errors" -> {}, 
     "input" -> "x'(0)=v_i,", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "feb3b5fb-0d82-6c40-8caa-a0d7e9d19af3"],
 " where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["v", "TI"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "v_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fae3b550-f851-af4b-a35c-70abdaadad21"],
 " is the initial velocity of the ball. We also neglect all forces except the \
gravitational force, so we set ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["x", "TI"], "\[Prime]\[Prime]"], 
         RowBox[{"(", 
           StyleBox["t", "TI"], ")"}], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["y", "TI"], "\[Prime]\[Prime]"], 
         RowBox[{"(", 
           StyleBox["t", "TI"], ")"}], "\[LongEqual]", "0", ","}], 
       TraditionalForm], "errors" -> {}, "input" -> "x''(t)=y''(t)=0,", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5945a918-7960-314d-8846-4f51a0dfc08a"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["z", "TI"], "\[Prime]\[Prime]"], 
         RowBox[{"(", 
           StyleBox["t", "TI"], ")"}], "\[LongEqual]", "-", 
         StyleBox["g", "TI"], ","}], TraditionalForm], "errors" -> {}, 
     "input" -> "z''(t)=-g,", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a3fa8fc2-fd01-5745-a2af-a0bf3bb14da0"],
 " where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["g", "TI"], "\[LongEqual]", "9.81", 
         StyleBox["m", "TI"], "/", 
         SuperscriptBox[
          StyleBox["s", "TI"], "2"], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> "g=9.81 m/s^2.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a7b15c49-78eb-0947-b373-2c00e8578aff"],
 " \n\nFor now, let us consider a static case: the ball is bouncing on a \
4-step staircase with initial height ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["h", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "5"}], TraditionalForm], 
     "errors" -> {}, "input" -> "h_i=5", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1f52e374-ed84-2c46-82b0-ae1483f77b4a"],
 ", an initial velocity of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["v", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "1", ","}], TraditionalForm], 
     "errors" -> {}, "input" -> "v_i=1,", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e940f58c-b530-154a-9933-2060719c027f"],
 " and a runtime of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["t", "TI"], "max"], "\[LongEqual]", "10"}], 
       TraditionalForm], "errors" -> {}, "input" -> "t_{\\text{max}}=10", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ced04836-1682-b84f-9e4b-2b445f00552c"],
 " seconds."
}], "Text",
 CellChangeTimes->{{3.9295249673855352`*^9, 3.929524970717665*^9}, {
  3.929525169974308*^9, 3.929525176622694*^9}, {3.929525255456488*^9, 
  3.9295253066858807`*^9}, {3.929525340220009*^9, 3.929525341244366*^9}, {
  3.9295253918328915`*^9, 3.9295254245229053`*^9}, {3.929525473821251*^9, 
  3.92952554655706*^9}, {3.9295256714149017`*^9, 3.929525772673559*^9}, {
  3.9295260517347813`*^9, 3.929526154782503*^9}, {3.929526209392782*^9, 
  3.9295265646306057`*^9}, {3.929530995790085*^9, 3.929531122653538*^9}, {
  3.9295356155953636`*^9, 3.929535676500326*^9}, {3.929535717586066*^9, 
  3.9295357419892406`*^9}, {3.929535870828432*^9, 3.929535887815901*^9}, {
  3.9295359226747437`*^9, 3.9295359248139935`*^9}, {3.929535959205871*^9, 
  3.929536058059086*^9}, {3.9296587348819065`*^9, 3.929658735986423*^9}, {
  3.9296587772696877`*^9, 3.92965881432164*^9}, {3.929696769403759*^9, 
  3.92969677278715*^9}},ExpressionUUID->"db5fd27c-657d-2340-b5bd-\
c7febdb6dbcc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"g", "=", "9.81"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"numSteps", "=", "4"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"heighti", "=", "5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"velocityi", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"runtime", "=", "10"}], ";"}]}], "Code",
 InitializationCell->False,
 CellChangeTimes->{{3.929535579803707*^9, 3.92953558101268*^9}, {
  3.92953567871171*^9, 3.929535699494875*^9}, {3.929535931971239*^9, 
  3.9295359343180733`*^9}, {3.9295360161548653`*^9, 3.929536019847679*^9}, {
  3.9295360656457386`*^9, 3.929536075140406*^9}},
 CellLabel->"In[30]:=",ExpressionUUID->"d13b9660-6a40-cc4a-b81d-7485ca9071e6"],

Cell[TextData[{
 "The function ",
 Cell[BoxData[
  StyleBox["NDSolve",
   FontWeight->"Bold"]], "InlineCode",ExpressionUUID->
  "3bf7a99b-f135-bd4b-9c36-759b4ef01729"],
 " solves for the functions in a differential equation given a set of \
equations. Before we can use the solver, we must first define a set of \
equations, as well as add a staircase and account for the bouncing motion:"
}], "Text",
 CellChangeTimes->{{3.929535724959144*^9, 3.9295357499156055`*^9}, {
  3.929658849798992*^9, 3.929658855185846*^9}, {3.9297030991467304`*^9, 
  3.9297031898625317`*^9}, {3.9297032435131626`*^9, 3.929703244282379*^9}, {
  3.929713171410942*^9, 
  3.9297131749970436`*^9}},ExpressionUUID->"21022816-7564-c14f-82dc-\
38058d64341c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"x", "[", "0", "]"}], "==", "0"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"y", "[", "0", "]"}], "==", "0.5"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"z", "[", "0", "]"}], "==", "heighti"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"x", "'"}], "[", "0", "]"}], "==", "velocityi"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"y", "'"}], "[", "0", "]"}], "==", "0"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"z", "'"}], "[", "0", "]"}], "==", "0"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"x", "''"}], "[", "t", "]"}], "==", "0"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"y", "''"}], "[", "t", "]"}], "==", "0"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"z", "''"}], "[", "t", "]"}], "==", 
     RowBox[{"-", "g"}]}]}], "}"}], ";"}]], "Code",
 InitializationCell->False,
 CellChangeTimes->{
  3.9295248649556446`*^9, {3.929524930584324*^9, 3.929524960253229*^9}, {
   3.929525556280958*^9, 3.92952558988562*^9}, {3.929525871616387*^9, 
   3.9295258766283245`*^9}, {3.929526000442946*^9, 3.929526019272597*^9}, {
   3.9295261318651924`*^9, 3.929526132009561*^9}, {3.9295268058886585`*^9, 
   3.9295268063267736`*^9}, 3.929527247891956*^9, 3.929703200185753*^9},
 CellLabel->"In[6]:=",ExpressionUUID->"d7e36c29-02fe-1442-9652-0c885d341f93"],

Cell[CellGroupData[{

Cell["Adding a staircase", "Subsection",
 CellChangeTimes->{{3.92952725826906*^9, 3.929527260766512*^9}, {
  3.929713168429184*^9, 
  3.9297131690701065`*^9}},ExpressionUUID->"9709fd2a-f993-4a4c-8cbc-\
ecb4e01c68fd"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "(", 
         StyleBox["t", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "a(t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "72f05c39-5608-3443-827f-001c2e6bef23"],
 " be a function that models a staircase. The function ",
 Cell[BoxData[
  StyleBox["WhenEvent",
   FontWeight->"Bold"]], "InlineCode",ExpressionUUID->
  "26d165e5-d30e-e84a-abe1-9910157cce36"],
 " inside ",
 Cell[BoxData[
  StyleBox["NDSolve",
   FontWeight->"Bold"]], "InlineCode",ExpressionUUID->
  "6beede75-d029-944b-8adc-4777b43eaed0"],
 " is used to model the staircase. Whenever the x-position of the ball is an \
integer, we want to create a step until the height reaches 0."
}], "Text",
 CellChangeTimes->{{3.929527271815567*^9, 3.929527272491497*^9}, {
  3.929529160589264*^9, 3.929529169307146*^9}, {3.929529223196213*^9, 
  3.929529324359094*^9}, {3.929529485736429*^9, 3.9295295381748505`*^9}, {
  3.929529622779125*^9, 3.929529696821791*^9}, {3.929530105888521*^9, 
  3.929530206472906*^9}, {3.92953729724065*^9, 
  3.929537298353407*^9}},ExpressionUUID->"1eb000d6-54e9-e24e-8fc8-\
9f21893d8fca"],

Cell[BoxData[
 RowBox[{
  RowBox[{"WhenEvent", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Mod", "[", 
      RowBox[{
       RowBox[{"x", "[", "t", "]"}], ",", "1"}], "]"}], "==", "0"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"If", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"a", "[", "t", "]"}], ">", "0"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"a", "[", "t", "]"}], "->", 
       RowBox[{
        RowBox[{"a", "[", "t", "]"}], "-", "1"}]}], ",", 
      "\[IndentingNewLine]", "\"\<RemoveEvent\>\""}], "]"}]}], "]"}], 
  ";"}]], "Code",
 InitializationCell->False,
 CellChangeTimes->{3.929529318615277*^9, 3.9297032062398663`*^9},
 CellLabel->"In[7]:=",ExpressionUUID->"f091cd9f-2a5d-6747-b1be-2b28c98588dc"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Modeling the bouncing motion", "Subsection",
 CellChangeTimes->{{3.929527278563696*^9, 3.929527287539044*^9}, 
   3.929538990260105*^9},ExpressionUUID->"c1fa7feb-38b7-b343-9337-\
312d933ddfd8"],

Cell[TextData[{
 "When the ball hits one of the stairs, we want the ball to bounce off with \
90% of its previous velocity. To model this, we negate the ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["z", "TI"], TraditionalForm], "errors" -> {}, "input" -> "z", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f670e0c6-70bf-da46-82b2-4dfc8ba5bada"],
 " coordinate while multiplying the ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["x", "TI"], ",", 
         StyleBox["y", "TI"], ","}], TraditionalForm], "errors" -> {}, 
     "input" -> "x,y,", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e8231210-a654-ef40-93a0-a260ac8b15b6"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["z", "TI"], TraditionalForm], "errors" -> {}, "input" -> "z", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6123b928-1b44-9f4f-88de-549dc543ccd6"],
 " velocities by ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["0.9.", TraditionalForm], "errors" -> {}, "input" -> 
     "0.9.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f8f42d1b-939a-af42-b0dc-21261fbae663"],
 " Next, we want to store the points where the trajectory of the ball and the \
staircase intersect. The ",
 Cell[BoxData[
  StyleBox["Sow",
   FontWeight->"Bold"]], "InlineCode",ExpressionUUID->
  "4a6fc810-cafc-0946-9276-cca34d8dfc5e"],
 " function is used to obtain the coordinates of the bounces and the times of \
the bounces. "
}], "Text",
 CellChangeTimes->{{3.92952681508656*^9, 3.929526939968119*^9}, {
  3.929526982993334*^9, 3.929526995263071*^9}, {3.929527144993941*^9, 
  3.9295271459382057`*^9}, {3.9295271860331993`*^9, 3.929527224803499*^9}, {
  3.929529420165329*^9, 3.9295294636609993`*^9}, {3.929529545080124*^9, 
  3.929529601809046*^9}, {3.92960736914817*^9, 3.929607419174689*^9}, {
  3.929658920569111*^9, 3.929658936497974*^9}, {3.929659066958908*^9, 
  3.929659157048168*^9}, {3.929659191198311*^9, 3.929659224490125*^9}, {
  3.929702926369608*^9, 
  3.929702934580503*^9}},ExpressionUUID->"9408f581-085c-6942-93c3-\
df0f2786d16d"],

Cell[TextData[{
 "The following code models the bouncing motion of the ball. The intersection \
points are stored in the form ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"{", 
         RowBox[{
           StyleBox["x", "TI"], ",", 
           StyleBox["y", "TI"], ",", 
           StyleBox["z", "TI"], ",", 
           StyleBox["t", "TI"]}], "}"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\{x,y,z,t\\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ddc3a1c0-2ead-9947-aade-d52dfc28a3f4"],
 ":"
}], "CodeText",
 CellChangeTimes->{{3.9296591642727337`*^9, 3.929659182591411*^9}, {
  3.929659228934208*^9, 
  3.9296592834834023`*^9}},ExpressionUUID->"07b325f1-c7e9-2641-a7e8-\
c03a7a488f9d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"WhenEvent", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"z", "[", "t", "]"}], "==", 
      RowBox[{"a", "[", "t", "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"x", "'"}], "[", "t", "]"}], ",", 
         RowBox[{
          RowBox[{"y", "'"}], "[", "t", "]"}], ",", 
         RowBox[{
          RowBox[{"z", "'"}], "[", "t", "]"}]}], "}"}], "->", 
       RowBox[{"0.9", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"x", "'"}], "[", "t", "]"}], ",", 
          RowBox[{
           RowBox[{"y", "'"}], "[", "t", "]"}], ",", 
          RowBox[{"-", 
           RowBox[{
            RowBox[{"z", "'"}], "[", "t", "]"}]}]}], "}"}]}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Sow", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", "[", "t", "]"}], ",", 
         RowBox[{"y", "[", "t", "]"}], ",", 
         RowBox[{"z", "[", "t", "]"}], ",", "t"}], "}"}], "]"}]}], "}"}]}], 
   "]"}], ";"}]], "Code",
 InitializationCell->False,
 CellChangeTimes->{{3.929527002380287*^9, 3.9295270155656986`*^9}, {
   3.929527101834334*^9, 3.92952710789151*^9}, {3.929527147545714*^9, 
   3.92952715692457*^9}, {3.9296148531864853`*^9, 3.9296148665265636`*^9}, {
   3.929659000721796*^9, 3.929659004204464*^9}, {3.929702868814493*^9, 
   3.929702914875004*^9}, 3.929703209599048*^9},
 CellLabel->"In[8]:=",ExpressionUUID->"e09dd13d-88c0-a749-9780-a8cf432316c0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Storing the position functions and contact points", "Subsection",
 CellChangeTimes->{{3.929529758465233*^9, 
  3.9295297768147945`*^9}},ExpressionUUID->"c8c35f5d-5a48-e740-aa3b-\
567cdda503c2"],

Cell["Combining all the previous code, we get the following:", "Text",
 CellChangeTimes->{{3.929529789150276*^9, 3.929529796088724*^9}, {
   3.929529873117613*^9, 3.9295299057657204`*^9}, {3.929531129457657*^9, 
   3.929531130462027*^9}, {3.929535911311617*^9, 3.92953591144911*^9}, 
   3.929537064688236*^9, {3.9296078599992504`*^9, 
   3.929607862758787*^9}},ExpressionUUID->"ee563875-f0bc-af4c-ac51-\
872d74be16ba"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ballsteps", ",", 
     RowBox[{"{", "points", "}"}]}], "}"}], "=", 
   RowBox[{
    RowBox[{"NDSolve", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"x", "[", "0", "]"}], "==", "0"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"y", "[", "0", "]"}], "==", "0.5"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"z", "[", "0", "]"}], "==", "heighti"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"x", "'"}], "[", "0", "]"}], "==", "velocityi"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"y", "'"}], "[", "0", "]"}], "==", "0"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"z", "'"}], "[", "0", "]"}], "==", "0"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"x", "''"}], "[", "t", "]"}], "==", "0"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"y", "''"}], "[", "t", "]"}], "==", "0"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"z", "''"}], "[", "t", "]"}], "==", 
         RowBox[{"-", "g"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"a", "[", "0", "]"}], "==", "numSteps"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"WhenEvent", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"Mod", "[", 
            RowBox[{
             RowBox[{"x", "[", "t", "]"}], ",", "1"}], "]"}], "==", "0"}], 
          ",", "\[IndentingNewLine]", 
          RowBox[{"If", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"a", "[", "t", "]"}], ">", "0"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"a", "[", "t", "]"}], "->", 
             RowBox[{
              RowBox[{"a", "[", "t", "]"}], "-", "1"}]}], ",", 
            "\[IndentingNewLine]", "\"\<RemoveEvent\>\""}], "]"}]}], "]"}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{"WhenEvent", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"z", "[", "t", "]"}], "==", 
            RowBox[{"a", "[", "t", "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"x", "'"}], "[", "t", "]"}], ",", 
               RowBox[{
                RowBox[{"y", "'"}], "[", "t", "]"}], ",", 
               RowBox[{
                RowBox[{"z", "'"}], "[", "t", "]"}]}], "}"}], "->", 
             RowBox[{"0.9", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"x", "'"}], "[", "t", "]"}], ",", 
                RowBox[{
                 RowBox[{"y", "'"}], "[", "t", "]"}], ",", 
                RowBox[{"-", 
                 RowBox[{
                  RowBox[{"z", "'"}], "[", "t", "]"}]}]}], "}"}]}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Sow", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"x", "[", "t", "]"}], ",", 
               RowBox[{"y", "[", "t", "]"}], ",", 
               RowBox[{"z", "[", "t", "]"}], ",", "t"}], "}"}], "]"}]}], 
           "}"}]}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"x", ",", "y", ",", "z", ",", "a"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "runtime"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"DiscreteVariables", "->", 
       RowBox[{"{", "a", "}"}]}]}], "]"}], "//", "Reap"}]}], ";"}]], "Code",
 InitializationCell->False,
 CellChangeTimes->{
  3.929530046937811*^9, {3.929535764721386*^9, 3.929535773462944*^9}, {
   3.929536604021452*^9, 3.9295366251302547`*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"de6f6227-79e5-0a48-8c9c-4dcaa3d18111"],

Cell[TextData[{
 "The list ",
 Cell[BoxData[
  StyleBox["ballsteps", "Code"]], "InlineCode",ExpressionUUID->
  "95e3477d-775b-5840-b0e0-d391735932b0"],
 " stores the parametric functions ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["x", "TI"], 
         RowBox[{"(", 
           StyleBox["t", "TI"], ")"}], ",", 
         StyleBox["y", "TI"], 
         RowBox[{"(", 
           StyleBox["t", "TI"], ")"}], ",", 
         StyleBox["z", "TI"], 
         RowBox[{"(", 
           StyleBox["t", "TI"], ")"}], ","}], TraditionalForm], 
     "errors" -> {}, "input" -> "x(t), y(t), z(t),", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1f4abcca-a5b5-914b-b43b-83d44d7fabd1"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "(", 
         StyleBox["t", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "a(t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "72a4ff65-088c-3344-85bd-05d917d9ab01"],
 "."
}], "CodeText",
 CellChangeTimes->{{3.929535801031178*^9, 3.929535810401316*^9}, {
  3.929536214919316*^9, 3.929536215438597*^9}, {3.929659298251465*^9, 

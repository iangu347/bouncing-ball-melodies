Cell[CellGroupData[{

Cell["Updated code with buttons", "Subsubsection",
 CellChangeTimes->{{3.929573318810816*^9, 
  3.929573338964678*^9}},ExpressionUUID->"cf1abdc2-a65e-e246-8658-\
9e8a6efbfa15"],

Cell[BoxData[
 RowBox[{"DynamicModule", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "ballsteps", ",", "points", ",", "hitTimes", ",", "durations", ",", "xs", 
     ",", "pitches", ",", 
     RowBox[{"running", "=", "False"}], ",", "audio", ",", 
     RowBox[{"numSteps", "=", "4"}], ",", 
     RowBox[{"heighti", "=", "5"}], ",", 
     RowBox[{"velocityi", "=", "1"}], ",", 
     RowBox[{"g", "=", "9.81"}], ",", 
     RowBox[{"runtime", "=", "10"}], ",", 
     RowBox[{"instrument", "=", "\"\<Piano\>\""}], ",", 
     RowBox[{"numBalls", "=", "1"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Column", "[", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Button", "[", "\[IndentingNewLine]", 
       RowBox[{"\"\<Run Animation\>\"", ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"running", "=", "True"}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ballsteps", ",", 
            RowBox[{"{", "points", "}"}]}], "}"}], "=", 
          RowBox[{
           RowBox[{"NDSolve", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"x", "[", "0", "]"}], "==", "0"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"y", "[", "0", "]"}], "==", "0.5"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"z", "[", "0", "]"}], "==", "heighti"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{
                 RowBox[{"x", "'"}], "[", "0", "]"}], "==", "velocityi"}], 
               ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{
                 RowBox[{"y", "'"}], "[", "0", "]"}], "==", "0"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{
                 RowBox[{"z", "'"}], "[", "0", "]"}], "==", "0"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{
                 RowBox[{"x", "''"}], "[", "t", "]"}], "==", "0"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{
                 RowBox[{"y", "''"}], "[", "t", "]"}], "==", "0"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{
                 RowBox[{"z", "''"}], "[", "t", "]"}], "==", 
                RowBox[{"-", "g"}]}], ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"a", "[", "0", "]"}], "==", "numSteps"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"WhenEvent", "[", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Mod", "[", 
                   RowBox[{
                    RowBox[{"x", "[", "t", "]"}], ",", "1"}], "]"}], "==", 
                  "0"}], ",", "\[IndentingNewLine]", 
                 RowBox[{"If", "[", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"a", "[", "t", "]"}], ">", "0"}], ",", 
                   "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"a", "[", "t", "]"}], "->", 
                    RowBox[{
                    RowBox[{"a", "[", "t", "]"}], "-", "1"}]}], ",", 
                   "\[IndentingNewLine]", "\"\<RemoveEvent\>\""}], "]"}]}], 
                "]"}], ",", "\[IndentingNewLine]", 
               RowBox[{"WhenEvent", "[", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"z", "[", "t", "]"}], "==", 
                   RowBox[{"a", "[", "t", "]"}]}], "}"}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"x", "'"}], "[", "t", "]"}], ",", 
                    RowBox[{
                    RowBox[{"y", "'"}], "[", "t", "]"}], ",", 
                    RowBox[{
                    RowBox[{"z", "'"}], "[", "t", "]"}]}], "}"}], "->", 
                    RowBox[{"0.9", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"x", "'"}], "[", "t", "]"}], ",", 
                    RowBox[{
                    RowBox[{"y", "'"}], "[", "t", "]"}], ",", 
                    RowBox[{"-", 
                    RowBox[{
                    RowBox[{"z", "'"}], "[", "t", "]"}]}]}], "}"}]}]}], ",", 
                   "\[IndentingNewLine]", 
                   RowBox[{"Sow", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"x", "[", "t", "]"}], ",", 
                    RowBox[{"y", "[", "t", "]"}], ",", 
                    RowBox[{"z", "[", "t", "]"}], ",", "t"}], "}"}], "]"}]}], 
                  "}"}]}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{"x", ",", "y", ",", "z", ",", "a"}], "}"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{"t", ",", "0", ",", "runtime"}], "}"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"DiscreteVariables", "->", 
              RowBox[{"{", "a", "}"}]}]}], "]"}], "//", "Reap"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"hitTimes", "=", 
          RowBox[{"points", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "4"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"durations", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"hitTimes", "[", 
              RowBox[{"[", 
               RowBox[{"i", "+", "1"}], "]"}], "]"}], "-", 
             RowBox[{"hitTimes", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"i", ",", " ", 
              RowBox[{
               RowBox[{"Length", "[", "hitTimes", "]"}], "-", "1"}]}], 
             "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"xs", "=", 
          RowBox[{"points", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"pitches", "=", 
          RowBox[{"Floor", "/@", "xs"}]}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"audio", "=", 
          RowBox[{"Audio", "@", 
           RowBox[{"Sound", "@", 
            RowBox[{"Flatten", "@", 
             RowBox[{"Append", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"SoundNote", "[", 
                 RowBox[{"None", ",", 
                  RowBox[{"hitTimes", "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "}"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"SoundNote", "@@@", 
                  RowBox[{"Thread", "[", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Most", "[", "pitches", "]"}], ",", "durations", 
                    ",", "instrument"}], "}"}], "]"}]}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{"SoundNote", "[", 
                  RowBox[{
                   RowBox[{"Last", "[", "pitches", "]"}], ",", "1", ",", 
                   "instrument"}], "]"}]}], "}"}]}], "]"}]}]}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"AudioPlay", "[", "audio", "]"}], ";"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"ImageSize", "->", "261"}]}], "]"}], "\[IndentingNewLine]", 
      ",", "\[IndentingNewLine]", 
      RowBox[{"Button", "[", 
       RowBox[{"\"\<Reset\>\"", ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"AudioStop", "[", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"running", "=", "False"}], ";"}], ",", "\[IndentingNewLine]", 
        RowBox[{"ImageSize", "->", "261"}]}], "\[IndentingNewLine]", "]"}], 
      ",", "\[IndentingNewLine]", 
      RowBox[{"Dynamic", "[", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"running", ",", "\[IndentingNewLine]", 
         RowBox[{"Animate", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Show", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Plot3D", "[", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"Floor", "[", 
                 RowBox[{"numSteps", "+", "1", "-", "x"}], "]"}], "}"}], ",", 
               
               RowBox[{"{", 
                RowBox[{"x", ",", "0", ",", 
                 RowBox[{"runtime", "*", "velocityi"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"y", ",", "0", ",", "1"}], "}"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"PlotRange", "->", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"0", ",", 
                    RowBox[{"runtime", "*", "velocityi"}]}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"0", ",", "1"}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"0", ",", 
                    RowBox[{"heighti", "*", "1.1"}]}], "}"}]}], "}"}]}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"PlotStyle", "->", "White"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"Filling", "->", "Bottom"}], ",", 
               RowBox[{"Exclusions", "->", "None"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"Axes", "->", "False"}], ",", 
               RowBox[{"Mesh", "->", "True"}], ",", 
               RowBox[{"MeshFunctions", "->", 
                RowBox[{"(", 
                 RowBox[{"#3", "&"}], ")"}]}], ",", 
               RowBox[{"PlotPoints", "->", 
                RowBox[{"ControlActive", "[", 
                 RowBox[{"20", ",", "40"}], "]"}]}], ",", 
               RowBox[{"MaxRecursion", "->", 
                RowBox[{"ControlActive", "[", 
                 RowBox[{"2", ",", "4"}], "]"}]}], ",", 
               RowBox[{"Boxed", "->", "False"}]}], "\[IndentingNewLine]", 
              "]"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{"Graphics3D", "[", "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"Blue", ",", 
                RowBox[{"PointSize", "[", "0.025", "]"}], ",", 
                RowBox[{"Point", "[", 
                 RowBox[{"{", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"ballsteps", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], "[", "t",
                     "]"}], ",", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"ballsteps", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2", ",", "2"}], "]"}], "]"}], "[", "t",
                     "]"}], ",", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"ballsteps", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "3", ",", "2"}], "]"}], "]"}], "[", "t",
                     "]"}], "+", "0.025"}]}], "}"}], "]"}]}], "}"}], 
              "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}], 
           ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", "runtime"}], "}"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"AnimationRate", "->", "1"}], ",", "\[IndentingNewLine]", 
           RowBox[{"SaveDefinitions", "->", "True"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"AnimationRepetitions", "->", "1"}]}], 
          "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Press to run the animation\>\"", ",", "Bold"}], 
          "]"}]}], "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
       "]"}]}], "\[IndentingNewLine]", "}"}], "]"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{{3.9296068768383884`*^9, 3.929607036288395*^9}, {
   3.9296070723609657`*^9, 3.929607106091715*^9}, 3.929607346814686*^9, 
   3.929608206122095*^9, {3.929609213600389*^9, 3.929609215010282*^9}, {
   3.929609359764641*^9, 3.92960936130274*^9}, {3.929632211857115*^9, 
   3.929632212370936*^9}, {3.929696388350928*^9, 3.929696398754593*^9}, 
   3.929703835146244*^9, 
   3.929709458673708*^9},ExpressionUUID->"78c5a12b-b587-1c43-acbb-\
47c39dd856b4"]
}, Closed]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Adding adjustable initial conditions and different instruments\
\>", "Subsection",
 CellChangeTimes->{{3.929607283899605*^9, 3.9296072949189186`*^9}, {
  3.929627541913779*^9, 
  3.929627551713705*^9}},ExpressionUUID->"10c8c4a5-f623-6e42-baa6-\
b2fdb635cfbc"],

Cell[TextData[{
 "In order to add an input method to adjust the initial conditions, we use \
the ",
 Cell[BoxData[
  StyleBox["InputField",
   FontWeight->"Bold"]], "InlineCode",ExpressionUUID->
  "bb5ce740-b524-ee48-a7b7-ddd94300b7fa"],
 " and ",
 Cell[BoxData[
  StyleBox["PopupMenu",
   FontWeight->"Bold"]], "InlineCode",ExpressionUUID->
  "0d6ce8cc-bf1f-e245-af08-3450a0458205"],
 " functions combined with a ",
 Cell[BoxData[
  StyleBox["Dynamic",
   FontWeight->"Bold"]], "InlineCode",ExpressionUUID->
  "a4b64a5b-689a-f448-8653-e9f19a5cf3fa"],
 " variable. These adjustable parameters include ",
 Cell[BoxData[
  RowBox[{
  "heighti", ",", " ", "velocityi", ",", " ", "g", ",", " ", "numSteps", ",", 
   " ", "runtime", ","}]], "InlineCode",
  FontWeight->"Bold",ExpressionUUID->"2ad3c099-8c5e-9646-b02b-9ebe06fb7836"],
 " and ",
 Cell[BoxData[
  StyleBox["instrument",
   FontWeight->"Bold"]], "InlineCode",ExpressionUUID->
  "2edb4abf-cb03-394e-bf9e-28bdc728be42"],
 "."
}], "Text",
 CellChangeTimes->{{3.929607563958044*^9, 3.9296075848531513`*^9}, {
   3.9296077548235607`*^9, 3.929607786977062*^9}, {3.9296080025697517`*^9, 
   3.9296080433972473`*^9}, 3.929608104513737*^9, {3.92960824316214*^9, 
   3.9296084273941*^9}, {3.9296088536803093`*^9, 3.929608856017588*^9}, {
   3.929660033161869*^9, 
   3.929660034504226*^9}},ExpressionUUID->"615a2ba5-a0fa-2d4a-9d60-\
1a5faed2db90"],

Cell["\<\
The following code allows the user to input the initial conditions of the \
ball:\
\>", "CodeText",
 CellChangeTimes->{{3.92960836274629*^9, 3.929608368340153*^9}, {
  3.929608437469125*^9, 3.929608442983158*^9}, {3.929608507122761*^9, 
  3.929608529586986*^9}, {3.929608760196827*^9, 
  3.92960879584795*^9}},ExpressionUUID->"476f9e5b-ff9e-404e-b648-\
8adbd6ab78f6"],

Cell[BoxData[
 RowBox[{"DynamicModule", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "ballsteps", ",", "points", ",", "hitTimes", ",", "durations", ",", "xs", 
     ",", "pitches", ",", 
     RowBox[{"running", "=", "False"}], ",", "audio", ",", 
     RowBox[{"numSteps", "=", "4"}], ",", 
     RowBox[{"heighti", "=", "5"}], ",", 
     RowBox[{"velocityi", "=", "1"}], ",", 
     RowBox[{"g", "=", "9.81"}], ",", 
     RowBox[{"runtime", "=", "10"}], ",", 
     RowBox[{"instrument", "=", "\"\<Piano\>\""}], ",", 

Cell[CellGroupData[{

Cell["Making the staircase", "Subsection",
 CellChangeTimes->{{3.929536801378163*^9, 
  3.929536803349911*^9}},ExpressionUUID->"e9e1bc76-0cbd-1e43-b6e6-\
5c889842068b"],

Cell[TextData[{
 "First, let us plot a 3-D staircase. ",
 Cell[BoxData[
  StyleBox["Plot3D",
   FontWeight->"Bold"]], "InlineCode",ExpressionUUID->
  "79ed98e7-8785-8648-bb27-5d1891f34bd6"],
 " allows us to generate a plot of a three-dimensional function. The graph of \
the ",
 Cell[BoxData[
  StyleBox["Floor",
   FontWeight->"Bold"]], "InlineCode",ExpressionUUID->
  "c0f1551a-2728-3949-8415-fe145f693890"],
 " function is convenient for replicating the staircase."
}], "Text",
 CellChangeTimes->{{3.929530826388977*^9, 3.929530939641537*^9}, {
  3.9296593722020817`*^9, 
  3.9296594197723827`*^9}},ExpressionUUID->"2757843e-af6c-ec45-b532-\
1cb41e16081a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot3D", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"Floor", "[", 
     RowBox[{"numSteps", "+", "1", "-", "x"}], "]"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", 
     RowBox[{"runtime", "*", "velocityi"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", "0", ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"runtime", "*", "velocityi"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"heighti", "*", "1.1"}]}], "}"}]}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", "->", "White"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Filling", "->", "Bottom"}], ",", 
   RowBox[{"Exclusions", "->", "None"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Axes", "->", "False"}], ",", 
   RowBox[{"Mesh", "->", "True"}], ",", 
   RowBox[{"MeshFunctions", "->", 
    RowBox[{"(", 
     RowBox[{"#3", "&"}], ")"}]}], ",", 
   RowBox[{"PlotPoints", "->", 
    RowBox[{"ControlActive", "[", 
     RowBox[{"20", ",", "40"}], "]"}]}], ",", 
   RowBox[{"MaxRecursion", "->", 
    RowBox[{"ControlActive", "[", 
     RowBox[{"2", ",", "4"}], "]"}]}], ",", 
   RowBox[{"Boxed", "->", "False"}]}], "\[IndentingNewLine]", "]"}]], "Code",
 InitializationCell->False,

Cell[CellGroupData[{

Cell["Generating different pitches", "Subsection",
 CellChangeTimes->{{3.929613421678291*^9, 3.92961342393613*^9}, {
  3.929613483813781*^9, 
  3.929613490957882*^9}},ExpressionUUID->"f7e91ed5-5443-4a4e-8956-\
6f34a8057646"],

Cell["\<\
In the above code, every ball generates the same pitches. We adjust the code \
to make each ball generate a different pitch to make the sounds more \
interesting.\
\>", "Text",
 CellChangeTimes->{{3.929613494365572*^9, 3.9296135478337536`*^9}, {
  3.929660192988983*^9, 
  3.929660203718017*^9}},ExpressionUUID->"f34ab817-4c74-9c40-bf0c-\
536c589877b1"],

Cell[TextData[{
 "We find that the following code produces interesting intervals:\n(a \
temporary value for ",
 Cell[BoxData[
  StyleBox["numBalls",
   FontWeight->"Bold"]], "InlineCode",ExpressionUUID->
  "be70e8e6-bba6-964e-9935-6cbe10c5fcf2"],
 " is defined and then cleared for the code to run)"
}], "CodeText",
 CellChangeTimes->{{3.929613557080611*^9, 3.929613570396576*^9}, {
  3.929613625799032*^9, 3.929613651496544*^9}, {3.9296137125184536`*^9, 
  3.9296137205111732`*^9}, {3.9296137546702633`*^9, 3.9296137973962803`*^9}, {
  3.9296138639982777`*^9, 3.9296138717789726`*^9}, {3.9297091702560043`*^9, 
  3.9297091917676506`*^9}},ExpressionUUID->"cb638247-6751-ab45-99bf-\
335d9fb2fd8c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"numBalls", "=", "5"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"pitches", "=", 
     RowBox[{
      RowBox[{"Floor", "/@", "xs"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Floor", "[", 
          RowBox[{"12", "/", "numBalls"}], "]"}], "+", "1"}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{"i", "-", "1"}], ")"}]}]}]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "numBalls"}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{"Clear", "[", "numBalls", "]"}]}], "Code",
 InitializationCell->False,
 CellChangeTimes->{{3.9296138973496*^9, 3.929613915807625*^9}, {
  3.929704047454645*^9, 3.929704148716795*^9}},
 CellLabel->"In[23]:=",ExpressionUUID->"329e6002-9438-7242-bdbd-f9ca808eeb6f"],

Cell[TextData[{
 "Example table that displays the intervals between notes based on ",
 Cell[BoxData[
  StyleBox["numBalls",
   FontWeight->"Bold"]], "InlineCode",ExpressionUUID->
  "51ea432a-914c-d846-a7d9-9ddf237165b5"],
 ":"
}], "CodeText",
 CellChangeTimes->{{3.9297041704613957`*^9, 
  3.929704209459513*^9}},ExpressionUUID->"ba313aee-98c7-c94f-a022-\
0082efa0be1e"],

Cell[TextData[Cell[BoxData[GridBox[{
   {"numBalls", "Intervals"},
   {"2", "fifths"},
   {"3", "fourths"},
   {"4", 
    RowBox[{"major", " ", "thirds"}]},
   {"5", 
    RowBox[{"minor", " ", "thirds"}]},
   {"...", "..."}
  },
  GridBoxDividers->{
   "Columns" -> {{True}}, 
    "Rows" -> {{
      True}}}]],ExpressionUUID->"4e144520-e007-934d-89d7-063f75b8f46a"]], \
"CodeText",
 CellChangeTimes->{
  3.929613801480177*^9, {3.9296970672236843`*^9, 
   3.92969707052154*^9}},ExpressionUUID->"b220b30d-7f53-7c45-b212-\
8f6fbd408e89"],

Cell["Adding this to our code, we get the following:", "CodeText",
 CellChangeTimes->{{3.929613947729153*^9, 3.9296139659473495`*^9}, {
  3.929614062824196*^9, 3.92961408151268*^9}, {3.92961427351304*^9, 
  3.9296142870455112`*^9}, {3.9296149051437*^9, 
  3.929614907008482*^9}},ExpressionUUID->"0dc7e0b0-eac9-394d-9dc5-\
e25db73cb34c"],

Cell[CellGroupData[{

Cell["Code accounting for different pitches", "Subsubsection",
 CellChangeTimes->{{3.929614291215174*^9, 3.92961429289741*^9}, {
  3.929614918867895*^9, 3.9296149193458977`*^9}, {3.929615025864506*^9, 
  3.929615026294168*^9}, {3.929694962016079*^9, 3.9296949644240627`*^9}, {
  3.929697085265211*^9, 
  3.929697088595028*^9}},ExpressionUUID->"d4e44492-493c-e041-8d6e-\
8325ad52e910"],

Cell[BoxData[
 RowBox[{"DynamicModule", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "ballsteps", ",", "points", ",", "hitTimes", ",", "durations", ",", "xs", 
     ",", "pitches", ",", 
     RowBox[{"running", "=", "False"}], ",", "audio", ",", 
     RowBox[{"numSteps", "=", "4"}], ",", 
     RowBox[{"heighti", "=", "5"}], ",", 
     RowBox[{"velocityi", "=", "1"}], ",", 
     RowBox[{"g", "=", "9.81"}], ",", 
     RowBox[{"runtime", "=", "10"}], ",", 
     RowBox[{"instrument", "=", "\"\<Piano\>\""}], ",", 
     RowBox[{"numBalls", "=", "1"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Column", "[", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{"\"\<Initial height(m):\>\"", ",", "Bold"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"InputField", "[", 
       RowBox[{
        RowBox[{"Dynamic", "[", "heighti", "]"}], ",", "Number"}], "]"}], ",",
       "\[IndentingNewLine]", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<Initial velocity(m/s):\>\"", ",", "Bold"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"InputField", "[", 
       RowBox[{
        RowBox[{"Dynamic", "[", "velocityi", "]"}], ",", "Number"}], "]"}], 
      ",", "\[IndentingNewLine]", 
      RowBox[{"Style", "[", 
       RowBox[{
       "\"\<Gravitational acceleration(m/\!\(\*SuperscriptBox[\(s\), \
\(2\)]\)):\>\"", ",", "Bold"}], "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"InputField", "[", 
       RowBox[{
        RowBox[{"Dynamic", "[", "g", "]"}], ",", "Number"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<Number of stairs:\>\"", ",", "Bold"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"InputField", "[", 
       RowBox[{
        RowBox[{"Dynamic", "[", "numSteps", "]"}], ",", "Number"}], "]"}], 
      ",", "\[IndentingNewLine]", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<Number of balls:\>\"", ",", "Bold"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"InputField", "[", 
       RowBox[{
        RowBox[{"Dynamic", "[", "numBalls", "]"}], ",", "Number"}], "]"}], 
      ",", "\[IndentingNewLine]", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<Runtime(s):\>\"", ",", "Bold"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"InputField", "[", 
       RowBox[{
        RowBox[{"Dynamic", "[", "runtime", "]"}], ",", "Number"}], "]"}], ",",
       "\[IndentingNewLine]", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<Instrument:\>\"", ",", "Bold"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"PopupMenu", "[", 
       RowBox[{
        RowBox[{"Dynamic", "[", "instrument", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{
         "\"\<Piano\>\"", ",", "\"\<Guitar\>\"", ",", "\"\<Violin\>\"", ",", 
          "\"\<Voice\>\"", ",", "\"\<Woodblock\>\"", ",", "\"\<Xylophone\>\"",
           ",", "\"\<Gunshot\>\""}], "}"}]}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Dynamic", "[", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"heighti", ">", "numSteps"}], ",", 
         RowBox[{"Button", "[", "\[IndentingNewLine]", 
          RowBox[{"\"\<Run Animation\>\"", ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"running", "=", "True"}], ";", "\[IndentingNewLine]", 
            "\[IndentingNewLine]", 
            RowBox[{"Table", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"ballsteps", ",", 
                  RowBox[{"{", "points", "}"}]}], "}"}], "=", 
                RowBox[{
                 RowBox[{"NDSolve", "[", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"x", "[", "0", "]"}], "==", "0"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"y", "[", "0", "]"}], "==", 
                    RowBox[{"i", "/", 
                    RowBox[{"(", 
                    RowBox[{"numBalls", "+", "1"}], ")"}]}]}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"z", "[", "0", "]"}], "==", "heighti"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"x", "'"}], "[", "0", "]"}], "==", "velocityi"}], 
                    ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"y", "'"}], "[", "0", "]"}], "==", "0"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"z", "'"}], "[", "0", "]"}], "==", "0"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"x", "''"}], "[", "t", "]"}], "==", "0"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"y", "''"}], "[", "t", "]"}], "==", "0"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"z", "''"}], "[", "t", "]"}], "==", 
                    RowBox[{"-", "g"}]}], ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"a", "[", "0", "]"}], "==", "numSteps"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{"WhenEvent", "[", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Mod", "[", 
                    RowBox[{
                    RowBox[{"x", "[", "t", "]"}], ",", "1"}], "]"}], "==", 
                    "0"}], ",", "\[IndentingNewLine]", 
                    RowBox[{"If", "[", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"a", "[", "t", "]"}], ">", "0"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"a", "[", "t", "]"}], "->", 
                    RowBox[{
                    RowBox[{"a", "[", "t", "]"}], "-", "1"}]}], ",", 
                    "\[IndentingNewLine]", "\"\<RemoveEvent\>\""}], "]"}]}], 
                    "]"}], ",", "\[IndentingNewLine]", 
                    RowBox[{"WhenEvent", "[", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"z", "[", "t", "]"}], "==", 
                    RowBox[{"a", "[", "t", "]"}]}], "}"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"x", "'"}], "[", "t", "]"}], ",", 
                    RowBox[{
                    RowBox[{"y", "'"}], "[", "t", "]"}], ",", 
                    RowBox[{
                    RowBox[{"z", "'"}], "[", "t", "]"}]}], "}"}], "->", 
                    RowBox[{"0.9", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"x", "'"}], "[", "t", "]"}], ",", 
                    RowBox[{
                    RowBox[{"y", "'"}], "[", "t", "]"}], ",", 
                    RowBox[{"-", 
                    RowBox[{
                    RowBox[{"z", "'"}], "[", "t", "]"}]}]}], "}"}]}]}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Sow", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"x", "[", "t", "]"}], ",", 
                    RowBox[{"y", "[", "t", "]"}], ",", 
                    RowBox[{"z", "[", "t", "]"}], ",", "t"}], "}"}], "]"}]}], 
                    "}"}]}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
                   RowBox[{"{", 
                    RowBox[{"x", ",", "y", ",", "z", ",", "a"}], "}"}], ",", 
                   "\[IndentingNewLine]", 
                   RowBox[{"{", 
                    RowBox[{"t", ",", "0", ",", "runtime"}], "}"}], ",", 
                   "\[IndentingNewLine]", 
                   RowBox[{"DiscreteVariables", "->", 
                    RowBox[{"{", "a", "}"}]}]}], "]"}], "//", "Reap"}]}], ";",
                "\[IndentingNewLine]", "\[IndentingNewLine]", 
               RowBox[{"hitTimes", "=", 
                RowBox[{"points", "[", 
                 RowBox[{"[", 
                  RowBox[{"All", ",", "4"}], "]"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"durations", "=", 
                RowBox[{"Table", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"hitTimes", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", "+", "1"}], "]"}], "]"}], "-", 
                   RowBox[{"hitTimes", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"i", ",", " ", 
                    RowBox[{
                    RowBox[{"Length", "[", "hitTimes", "]"}], "-", "1"}]}], 
                   "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"xs", "=", 
                RowBox[{"points", "[", 
                 RowBox[{"[", 
                  RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"pitches", "=", 
                RowBox[{
                 RowBox[{"Floor", "/@", "xs"}], "+", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"Floor", "[", 
                    RowBox[{"12", "/", "numBalls"}], "]"}], "+", "1"}], ")"}],
                   "*", 
                  RowBox[{"(", 
                   RowBox[{"i", "-", "1"}], ")"}]}]}]}], ";", 
               "\[IndentingNewLine]", "\[IndentingNewLine]", 
               RowBox[{"audio", "=", 
                RowBox[{"Audio", "@", 
                 RowBox[{"Sound", "@", 
                  RowBox[{"Flatten", "@", 
                   RowBox[{"Append", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"SoundNote", "[", 
                    RowBox[{"None", ",", 
                    RowBox[{
                    RowBox[{"hitTimes", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "+", "0.4"}]}], "]"}], 
                    "}"}], ",", "\[IndentingNewLine]", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"SoundNote", "@@@", 
                    RowBox[{"Thread", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Most", "[", "pitches", "]"}], ",", "durations", 
                    ",", "instrument"}], "}"}], "]"}]}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{"SoundNote", "[", 
                    RowBox[{
                    RowBox[{"Last", "[", "pitches", "]"}], ",", "1", ",", 
                    "instrument"}], "]"}]}], "}"}]}], "]"}]}]}]}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"AudioPlay", "[", "audio", "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "numBalls"}], "}"}]}], "\[IndentingNewLine]",
              "]"}], ";"}], ",", "\[IndentingNewLine]", 
           RowBox[{"ImageSize", "->", "261"}]}], "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{
          "\"\<*Initial height must be greater than the number of steps\>\"", 
           ",", "Red"}], "]"}]}], "\[IndentingNewLine]", "]"}], 
       "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Button", "[", 
       RowBox[{"\"\<Reset\>\"", ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"AudioStop", "[", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"running", "=", "False"}], ";"}], ",", "\[IndentingNewLine]", 
        RowBox[{"ImageSize", "->", "261"}]}], "\[IndentingNewLine]", "]"}], 
      ",", "\[IndentingNewLine]", 
      RowBox[{"Dynamic", "[", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"running", ",", "\[IndentingNewLine]", 
         RowBox[{"Animate", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Show", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Plot3D", "[", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"Floor", "[", 
                 RowBox[{"numSteps", "+", "1", "-", "x"}], "]"}], "}"}], ",", 
               
               RowBox[{"{", 
                RowBox[{"x", ",", "0", ",", "runtime"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"y", ",", "0", ",", "1"}], "}"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"PlotRange", "->", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"0", ",", "runtime"}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"0", ",", "1"}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"0", ",", 
                    RowBox[{"heighti", "*", "1.1"}]}], "}"}]}], "}"}]}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"PlotStyle", "->", "White"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"Filling", "->", "Bottom"}], ",", 
               RowBox[{"Exclusions", "->", "None"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"Axes", "->", "False"}], ",", 
               RowBox[{"Mesh", "->", "True"}], ",", 
               RowBox[{"MeshFunctions", "->", 
                RowBox[{"(", 
                 RowBox[{"#3", "&"}], ")"}]}], ",", 
               RowBox[{"PlotPoints", "->", 
                RowBox[{"ControlActive", "[", 
                 RowBox[{"20", ",", "40"}], "]"}]}], ",", 
               RowBox[{"MaxRecursion", "->", 
                RowBox[{"ControlActive", "[", 
                 RowBox[{"2", ",", "4"}], "]"}]}], ",", 
               RowBox[{"Boxed", "->", "False"}]}], "\[IndentingNewLine]", 
              "]"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{"Table", "[", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"Graphics3D", "[", "\[IndentingNewLine]", 
                RowBox[{"{", 
                 RowBox[{"Blue", ",", 
                  RowBox[{"PointSize", "[", "0.025", "]"}], ",", 
                  RowBox[{"Point", "[", 
                   RowBox[{"{", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"ballsteps", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], "[", "t",
                     "]"}], ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"ballsteps", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2", ",", "2"}], "]"}], "]"}], "[", "t",
                     "]"}], "*", 
                    RowBox[{"i", "/", "numBalls"}]}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"ballsteps", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "3", ",", "2"}], "]"}], "]"}], "[", "t",
                     "]"}], "+", "0.025"}]}], "}"}], "]"}]}], "}"}], 
                "\[IndentingNewLine]", "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "numBalls"}], "}"}]}], 
              "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}], 
           ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", "runtime"}], "}"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"AnimationRate", "->", "1"}], ",", "\[IndentingNewLine]", 
           RowBox[{"SaveDefinitions", "->", "True"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"AnimationRepetitions", "->", "1"}]}], 
          "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Press to run the animation\>\"", ",", "Bold"}], 
          "]"}]}], "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
       "]"}]}], "\[IndentingNewLine]", "}"}], "]"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{{3.929614879719185*^9, 3.9296148815320454`*^9}, {

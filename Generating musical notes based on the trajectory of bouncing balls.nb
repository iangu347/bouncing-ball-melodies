Cell[CellGroupData[{

Cell["Updated code with adjustable parameters", "Subsubsection",
 CellChangeTimes->{{3.9296088779685097`*^9, 3.9296088844927464`*^9}, {
  3.929627564428076*^9, 
  3.929627565602213*^9}},ExpressionUUID->"8bd526ac-3c61-674d-b76f-\
c5a5f5a576f0"],

Cell[BoxData[
 RowBox[{"DynamicModule", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "ballsteps", ",", "points", ",", "hitTimes", ",", "durations", ",", "xs", 
     ",", "pitches", ",", 
     RowBox[{"running", "=", "False"}], ",", "audio", ",", 
     RowBox[{"numSteps", "=", "4"}], ",", 
     RowBox[{"heighti", "=", "5"}], ",", 
     RowBox[{"velocityi", "=", "1"}], ",", 
     RowBox[{"g", "=", "9.81"}], ",", 
     RowBox[{"runtime", "=", "10"}], ",", 
     RowBox[{"instrument", "=", "\"\<Piano\>\""}], ",", 
     RowBox[{"numBalls", "=", "1"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Column", "[", 
    RowBox[{"{", "\n", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{"\"\<Initial height(m):\>\"", ",", "Bold"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"InputField", "[", 
       RowBox[{
        RowBox[{"Dynamic", "[", "heighti", "]"}], ",", "Number"}], "]"}], ",",
       "\[IndentingNewLine]", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<Initial velocity(m/s):\>\"", ",", "Bold"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"InputField", "[", 
       RowBox[{
        RowBox[{"Dynamic", "[", "velocityi", "]"}], ",", "Number"}], "]"}], 
      ",", "\[IndentingNewLine]", 
      RowBox[{"Style", "[", 
       RowBox[{
       "\"\<Gravitational acceleration(m/\!\(\*SuperscriptBox[\(s\), \
\(2\)]\)):\>\"", ",", "Bold"}], "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"InputField", "[", 
       RowBox[{
        RowBox[{"Dynamic", "[", "g", "]"}], ",", "Number"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<Number of stairs:\>\"", ",", "Bold"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"InputField", "[", 
       RowBox[{
        RowBox[{"Dynamic", "[", "numSteps", "]"}], ",", "Number"}], "]"}], 
      ",", "\[IndentingNewLine]", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<Runtime(s):\>\"", ",", "Bold"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"InputField", "[", 
       RowBox[{
        RowBox[{"Dynamic", "[", "runtime", "]"}], ",", "Number"}], "]"}], ",",
       "\[IndentingNewLine]", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<Instrument:\>\"", ",", "Bold"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"PopupMenu", "[", 
       RowBox[{
        RowBox[{"Dynamic", "[", "instrument", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{
         "\"\<Piano\>\"", ",", "\"\<Guitar\>\"", ",", "\"\<Violin\>\"", ",", 
          "\"\<Voice\>\"", ",", "\"\<Woodblock\>\"", ",", "\"\<Xylophone\>\"",
           ",", "\"\<Gunshot\>\""}], "}"}]}], "]"}], ",", "\n", 
      RowBox[{"Dynamic", "[", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"heighti", ">", "numSteps"}], ",", 
         RowBox[{"Button", "[", "\[IndentingNewLine]", 
          RowBox[{"\"\<Run Animation\>\"", ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"running", "=", "True"}], ";", "\[IndentingNewLine]", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"ballsteps", ",", 
               RowBox[{"{", "points", "}"}]}], "}"}], "=", 
             RowBox[{
              RowBox[{"NDSolve", "[", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"x", "[", "0", "]"}], "==", "0"}], ",", 
                  "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"y", "[", "0", "]"}], "==", "0.5"}], ",", 
                  "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"z", "[", "0", "]"}], "==", "heighti"}], ",", 
                  "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"x", "'"}], "[", "0", "]"}], "==", "velocityi"}], 
                  ",", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"y", "'"}], "[", "0", "]"}], "==", "0"}], ",", 
                  "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"z", "'"}], "[", "0", "]"}], "==", "0"}], ",", 
                  "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"x", "''"}], "[", "t", "]"}], "==", "0"}], ",", 
                  "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"y", "''"}], "[", "t", "]"}], "==", "0"}], ",", 
                  "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"z", "''"}], "[", "t", "]"}], "==", 
                   RowBox[{"-", "g"}]}], ",", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"a", "[", "0", "]"}], "==", "numSteps"}], ",", 
                  "\[IndentingNewLine]", 
                  RowBox[{"WhenEvent", "[", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Mod", "[", 
                    RowBox[{
                    RowBox[{"x", "[", "t", "]"}], ",", "1"}], "]"}], "==", 
                    "0"}], ",", "\[IndentingNewLine]", 
                    RowBox[{"If", "[", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"a", "[", "t", "]"}], ">", "0"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"a", "[", "t", "]"}], "->", 
                    RowBox[{
                    RowBox[{"a", "[", "t", "]"}], "-", "1"}]}], ",", 
                    "\[IndentingNewLine]", "\"\<RemoveEvent\>\""}], "]"}]}], 
                   "]"}], ",", "\[IndentingNewLine]", 
                  RowBox[{"WhenEvent", "[", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"z", "[", "t", "]"}], "==", 
                    RowBox[{"a", "[", "t", "]"}]}], "}"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"x", "'"}], "[", "t", "]"}], ",", 
                    RowBox[{
                    RowBox[{"y", "'"}], "[", "t", "]"}], ",", 
                    RowBox[{
                    RowBox[{"z", "'"}], "[", "t", "]"}]}], "}"}], "->", 
                    RowBox[{"0.9", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"x", "'"}], "[", "t", "]"}], ",", 
                    RowBox[{
                    RowBox[{"y", "'"}], "[", "t", "]"}], ",", 
                    RowBox[{"-", 
                    RowBox[{
                    RowBox[{"z", "'"}], "[", "t", "]"}]}]}], "}"}]}]}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Sow", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"x", "[", "t", "]"}], ",", 
                    RowBox[{"y", "[", "t", "]"}], ",", 
                    RowBox[{"z", "[", "t", "]"}], ",", "t"}], "}"}], "]"}]}], 
                    "}"}]}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
                RowBox[{"{", 
                 RowBox[{"x", ",", "y", ",", "z", ",", "a"}], "}"}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{"{", 
                 RowBox[{"t", ",", "0", ",", "runtime"}], "}"}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{"DiscreteVariables", "->", 
                 RowBox[{"{", "a", "}"}]}]}], "]"}], "//", "Reap"}]}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"hitTimes", "=", 
             RowBox[{"points", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "4"}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"durations", "=", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"hitTimes", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", "+", "1"}], "]"}], "]"}], "-", 
                RowBox[{"hitTimes", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"i", ",", " ", 
                 RowBox[{
                  RowBox[{"Length", "[", "hitTimes", "]"}], "-", "1"}]}], 
                "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"xs", "=", 
             RowBox[{"points", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"pitches", "=", 
             RowBox[{"Floor", "/@", "xs"}]}], ";", " ", "\[IndentingNewLine]",
             "\[IndentingNewLine]", 
            RowBox[{"audio", "=", 
             RowBox[{"Audio", "@", 
              RowBox[{"Sound", "@", 
               RowBox[{"Flatten", "@", 
                RowBox[{"Append", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"SoundNote", "[", 
                    RowBox[{"None", ",", 
                    RowBox[{
                    RowBox[{"hitTimes", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "+", "0.4"}]}], "]"}], 
                   "}"}], ",", "\[IndentingNewLine]", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"SoundNote", "@@@", 
                    RowBox[{"Thread", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Most", "[", "pitches", "]"}], ",", "durations", 
                    ",", "instrument"}], "}"}], "]"}]}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{"SoundNote", "[", 
                    RowBox[{
                    RowBox[{"Last", "[", "pitches", "]"}], ",", "1", ",", 
                    "instrument"}], "]"}]}], "}"}]}], "]"}]}]}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"AudioPlay", "[", "audio", "]"}], ";"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"ImageSize", "->", "261"}]}], "]"}], ",", " ", 
         RowBox[{"Style", "[", 
          RowBox[{
          "\"\<*Initial height must be greater than the number of steps\>\"", 
           ",", "Red"}], "]"}]}], "\n", "]"}], "\n", "]"}], 
      "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
      RowBox[{"Button", "[", 
       RowBox[{"\"\<Reset\>\"", ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"AudioStop", "[", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"running", "=", "False"}], ";"}], ",", "\[IndentingNewLine]", 
        RowBox[{"ImageSize", "->", "261"}]}], "\[IndentingNewLine]", "]"}], 
      ",", "\[IndentingNewLine]", 
      RowBox[{"Dynamic", "[", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"running", ",", "\[IndentingNewLine]", 
         RowBox[{"Animate", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Show", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Plot3D", "[", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"Floor", "[", 
                 RowBox[{"numSteps", "+", "1", "-", "x"}], "]"}], "}"}], ",", 
               
               RowBox[{"{", 
                RowBox[{"x", ",", "0", ",", 
                 RowBox[{"runtime", "*", "velocityi"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"y", ",", "0", ",", "1"}], "}"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"PlotRange", "->", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"0", ",", 
                    RowBox[{"runtime", "*", "velocityi"}]}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"0", ",", "1"}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"0", ",", 
                    RowBox[{"heighti", "*", "1.1"}]}], "}"}]}], "}"}]}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"PlotStyle", "->", "White"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"Filling", "->", "Bottom"}], ",", 
               RowBox[{"Exclusions", "->", "None"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"Axes", "->", "False"}], ",", 
               RowBox[{"Mesh", "->", "True"}], ",", 
               RowBox[{"MeshFunctions", "->", 
                RowBox[{"(", 
                 RowBox[{"#3", "&"}], ")"}]}], ",", 
               RowBox[{"PlotPoints", "->", 
                RowBox[{"ControlActive", "[", 
                 RowBox[{"20", ",", "40"}], "]"}]}], ",", 
               RowBox[{"MaxRecursion", "->", 
                RowBox[{"ControlActive", "[", 
                 RowBox[{"2", ",", "4"}], "]"}]}], ",", 
               RowBox[{"Boxed", "->", "False"}]}], "\[IndentingNewLine]", 
              "]"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{"Graphics3D", "[", "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"Blue", ",", 
                RowBox[{"PointSize", "[", "0.025", "]"}], ",", 
                RowBox[{"Point", "[", 
                 RowBox[{"{", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"ballsteps", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], "[", "t",
                     "]"}], ",", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"ballsteps", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2", ",", "2"}], "]"}], "]"}], "[", "t",
                     "]"}], ",", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"ballsteps", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "3", ",", "2"}], "]"}], "]"}], "[", "t",
                     "]"}], "+", "0.025"}]}], "}"}], "]"}]}], "}"}], 
              "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}], 
           ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", "runtime"}], "}"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"AnimationRate", "->", "1"}], ",", "\[IndentingNewLine]", 
           RowBox[{"SaveDefinitions", "->", "True"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"AnimationRepetitions", "->", "1"}]}], 
          "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Press to run the animation\>\"", ",", "Bold"}], 
          "]"}]}], "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
       "]"}]}], "\[IndentingNewLine]", "}"}], "]"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",

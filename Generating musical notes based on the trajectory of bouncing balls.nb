Cell[CellGroupData[{

Cell["Code with audio and animation", "Subsubsection",
 CellChangeTimes->{{3.9295728512644386`*^9, 3.929572852391399*^9}, {
  3.929709023615558*^9, 
  3.9297090257854786`*^9}},ExpressionUUID->"4552dabb-c460-6e48-ac1e-\
6938188914d1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ballsteps", ",", 
      RowBox[{"{", "points", "}"}]}], "}"}], "=", 
    RowBox[{
     RowBox[{"NDSolve", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"x", "[", "0", "]"}], "==", "0"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"y", "[", "0", "]"}], "==", "0.5"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"z", "[", "0", "]"}], "==", "heighti"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"x", "'"}], "[", "0", "]"}], "==", "velocityi"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"y", "'"}], "[", "0", "]"}], "==", "0"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"z", "'"}], "[", "0", "]"}], "==", "0"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"x", "''"}], "[", "t", "]"}], "==", "0"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"y", "''"}], "[", "t", "]"}], "==", "0"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"z", "''"}], "[", "t", "]"}], "==", 
          RowBox[{"-", "g"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"a", "[", "0", "]"}], "==", "numSteps"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"WhenEvent", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"Mod", "[", 
             RowBox[{
              RowBox[{"x", "[", "t", "]"}], ",", "1"}], "]"}], "==", "0"}], 
           ",", "\[IndentingNewLine]", 
           RowBox[{"If", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"a", "[", "t", "]"}], ">", "0"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"a", "[", "t", "]"}], "->", 
              RowBox[{
               RowBox[{"a", "[", "t", "]"}], "-", "1"}]}], ",", 
             "\[IndentingNewLine]", "\"\<RemoveEvent\>\""}], "]"}]}], "]"}], 
         ",", "\[IndentingNewLine]", 
         RowBox[{"WhenEvent", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"z", "[", "t", "]"}], "==", 
             RowBox[{"a", "[", "t", "]"}]}], "}"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"x", "'"}], "[", "t", "]"}], ",", 
                RowBox[{
                 RowBox[{"y", "'"}], "[", "t", "]"}], ",", 
                RowBox[{
                 RowBox[{"z", "'"}], "[", "t", "]"}]}], "}"}], "->", 
              RowBox[{"0.9", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{"x", "'"}], "[", "t", "]"}], ",", 
                 RowBox[{
                  RowBox[{"y", "'"}], "[", "t", "]"}], ",", 
                 RowBox[{"-", 
                  RowBox[{
                   RowBox[{"z", "'"}], "[", "t", "]"}]}]}], "}"}]}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"Sow", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"x", "[", "t", "]"}], ",", 
                RowBox[{"y", "[", "t", "]"}], ",", 
                RowBox[{"z", "[", "t", "]"}], ",", "t"}], "}"}], "]"}]}], 
            "}"}]}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", "z", ",", "a"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "runtime"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"DiscreteVariables", "->", 
        RowBox[{"{", "a", "}"}]}]}], "]"}], "//", "Reap"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Animate", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Show", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Plot3D", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Floor", "[", 
           RowBox[{"numSteps", "+", "1", "-", "x"}], "]"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "0", ",", 
           RowBox[{"runtime", "*", "velocityi"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"y", ",", "0", ",", "1"}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", 
              RowBox[{"runtime", "*", "velocityi"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "1"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", 
              RowBox[{"heighti", "*", "1.1"}]}], "}"}]}], "}"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"PlotStyle", "->", "White"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Filling", "->", "Bottom"}], ",", 
         RowBox[{"Exclusions", "->", "None"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Axes", "->", "False"}], ",", 
         RowBox[{"Mesh", "->", "True"}], ",", 
         RowBox[{"MeshFunctions", "->", 
          RowBox[{"(", 
           RowBox[{"#3", "&"}], ")"}]}], ",", 
         RowBox[{"PlotPoints", "->", 
          RowBox[{"ControlActive", "[", 
           RowBox[{"20", ",", "40"}], "]"}]}], ",", 
         RowBox[{"MaxRecursion", "->", 
          RowBox[{"ControlActive", "[", 
           RowBox[{"2", ",", "4"}], "]"}]}], ",", 
         RowBox[{"Boxed", "->", "False"}]}], "\[IndentingNewLine]", "]"}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{"Graphics3D", "[", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"Blue", ",", 
          RowBox[{"PointSize", "[", "0.025", "]"}], ",", 
          RowBox[{"Point", "[", 
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"ballsteps", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], "[", "t", 
              "]"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"ballsteps", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "2", ",", "2"}], "]"}], "]"}], "[", "t", 
              "]"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"ballsteps", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "3", ",", "2"}], "]"}], "]"}], "[", "t", 
               "]"}], "+", "0.025"}]}], "}"}], "]"}]}], "}"}], 
        "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "runtime"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"AnimationRate", "->", "1"}], ",", "\[IndentingNewLine]", 
     RowBox[{"SaveDefinitions", "->", "True"}], ",", "\[IndentingNewLine]", 
     RowBox[{"AnimationRepetitions", "->", "1"}]}], "\[IndentingNewLine]", 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hitTimes", "=", 
   RowBox[{"points", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "4"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"durations", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"hitTimes", "[", 
       RowBox[{"[", 
        RowBox[{"i", "+", "1"}], "]"}], "]"}], "-", 
      RowBox[{"hitTimes", "[", 
       RowBox[{"[", "i", "]"}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", 
       RowBox[{
        RowBox[{"Length", "[", "hitTimes", "]"}], "-", "1"}]}], "}"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xs", "=", 
   RowBox[{"points", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "1"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pitches", "=", 
   RowBox[{"Floor", "/@", "xs"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"audio", "=", 
   RowBox[{"Audio", "@", 
    RowBox[{"Sound", "@", 
     RowBox[{"Flatten", "@", 
      RowBox[{"Append", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"SoundNote", "[", 
          RowBox[{"None", ",", 
           RowBox[{"hitTimes", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"SoundNote", "@@@", 
           RowBox[{"Thread", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Most", "[", "pitches", "]"}], ",", "durations"}], 
             "}"}], "]"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"SoundNote", "[", 
           RowBox[{
            RowBox[{"Last", "[", "pitches", "]"}], ",", "1"}], "]"}]}], 
         "}"}]}], "]"}]}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"AudioPlay", "[", "audio", "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.929542219930425*^9, 3.929542274818495*^9}, {
   3.929542335077608*^9, 3.929542351359232*^9}, {3.92960926929459*^9, 
   3.929609270764028*^9}, {3.92960937903244*^9, 3.929609382800789*^9}, 
   3.929630907197508*^9, {3.92963101716133*^9, 3.929631017928572*^9}, {
   3.929631191285538*^9, 3.9296311913018684`*^9}, {3.929631408087734*^9, 
   3.929631408243431*^9}, {3.929632223545004*^9, 3.929632223999405*^9}, {
   3.929696329358099*^9, 3.9296963324963875`*^9}, {3.929703548258515*^9, 
   3.92970357389081*^9}, 3.929709014618534*^9},
 CellLabel->"In[43]:=",ExpressionUUID->"0e41d0ce-5cef-f64d-8d2c-e11a5493344f"]
}, Closed]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Creating a DynamicModule", "Section",
 CellChangeTimes->{{3.929286624251972*^9, 3.929286629115087*^9}, {
  3.929286668831503*^9, 3.9292866828098793`*^9}, {3.929542935899876*^9, 
  3.929542938020237*^9}, {3.929703660560293*^9, 
  3.929703667517074*^9}},ExpressionUUID->"d1555742-d1b8-b240-9854-\
ad468ce11ab3"],

Cell[TextData[{
 "In this section, we aim to incorporate a button that controls when to \
start/stop the simulation. Now that we have a working simulation of the ball \
for the static case, we also aim to add manipulable initial conditions for \
the ball. For this, converting the code to a singular ",
 Cell[BoxData[
  StyleBox["DynamicModule",
   FontWeight->"Bold"]], "InlineCode",ExpressionUUID->
  "2b4c0546-0d80-3f40-9a23-06c6aea7b30f"],
 " is necessary."
}], "Text",
 CellChangeTimes->{{3.929543827219255*^9, 3.929543875011313*^9}, {
  3.929547644206148*^9, 3.929547648316511*^9}, {3.929607307865454*^9, 
  3.929607308298237*^9}, {3.9296599501225853`*^9, 
  3.929659953671482*^9}},ExpressionUUID->"939e17f4-4a78-9f4d-86fd-\
d4d9458ab25c"],

Cell[CellGroupData[{

Cell["Previous code but formatted into a DynamicModule", "Subsubsection",
 CellChangeTimes->{{3.929548260470781*^9, 3.929548264613704*^9}, {
  3.929548383751018*^9, 3.929548385341064*^9}, {3.92965996386274*^9, 
  3.929659985809431*^9}, {3.92970366913575*^9, 
  3.929703672115443*^9}},ExpressionUUID->"36f93f53-bf21-164f-9f9c-\
9139845f62b3"],

Cell[BoxData[
 RowBox[{"DynamicModule", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "ballsteps", ",", "points", ",", "hitTimes", ",", "durations", ",", "xs", 
     ",", "pitches", ",", 
     RowBox[{"running", "=", "False"}], ",", "audio", ",", 
     RowBox[{"numSteps", "=", "4"}], ",", 
     RowBox[{"heighti", "=", "5"}], ",", 
     RowBox[{"velocityi", "=", "1"}], ",", 
     RowBox[{"g", "=", "9.81"}], ",", 
     RowBox[{"runtime", "=", "10"}], ",", 
     RowBox[{"instrument", "=", "\"\<Piano\>\""}], ",", 
     RowBox[{"numBalls", "=", "1"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ballsteps", ",", 
       RowBox[{"{", "points", "}"}]}], "}"}], "=", 
     RowBox[{
      RowBox[{"NDSolve", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"x", "[", "0", "]"}], "==", "0"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"y", "[", "0", "]"}], "==", "0.5"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"z", "[", "0", "]"}], "==", "heighti"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"x", "'"}], "[", "0", "]"}], "==", "velocityi"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"y", "'"}], "[", "0", "]"}], "==", "0"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"z", "'"}], "[", "0", "]"}], "==", "0"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"x", "''"}], "[", "t", "]"}], "==", "0"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"y", "''"}], "[", "t", "]"}], "==", "0"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"z", "''"}], "[", "t", "]"}], "==", 
           RowBox[{"-", "g"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"a", "[", "0", "]"}], "==", "numSteps"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"WhenEvent", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"Mod", "[", 
              RowBox[{
               RowBox[{"x", "[", "t", "]"}], ",", "1"}], "]"}], "==", "0"}], 
            ",", "\[IndentingNewLine]", 
            RowBox[{"If", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"a", "[", "t", "]"}], ">", "0"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"a", "[", "t", "]"}], "->", 
               RowBox[{
                RowBox[{"a", "[", "t", "]"}], "-", "1"}]}], ",", 
              "\[IndentingNewLine]", "\"\<RemoveEvent\>\""}], "]"}]}], "]"}], 
          ",", "\[IndentingNewLine]", 
          RowBox[{"WhenEvent", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"z", "[", "t", "]"}], "==", 
              RowBox[{"a", "[", "t", "]"}]}], "}"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{"x", "'"}], "[", "t", "]"}], ",", 
                 RowBox[{
                  RowBox[{"y", "'"}], "[", "t", "]"}], ",", 
                 RowBox[{
                  RowBox[{"z", "'"}], "[", "t", "]"}]}], "}"}], "->", 
               RowBox[{"0.9", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"x", "'"}], "[", "t", "]"}], ",", 
                  RowBox[{
                   RowBox[{"y", "'"}], "[", "t", "]"}], ",", 
                  RowBox[{"-", 
                   RowBox[{
                    RowBox[{"z", "'"}], "[", "t", "]"}]}]}], "}"}]}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"Sow", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"x", "[", "t", "]"}], ",", 
                 RowBox[{"y", "[", "t", "]"}], ",", 
                 RowBox[{"z", "[", "t", "]"}], ",", "t"}], "}"}], "]"}]}], 
             "}"}]}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"x", ",", "y", ",", "z", ",", "a"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"t", ",", "0", ",", "runtime"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"DiscreteVariables", "->", 
         RowBox[{"{", "a", "}"}]}]}], "]"}], "//", "Reap"}]}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"hitTimes", "=", 
     RowBox[{"points", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "4"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    
    RowBox[{"durations", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"hitTimes", "[", 
         RowBox[{"[", 
          RowBox[{"i", "+", "1"}], "]"}], "]"}], "-", 
        RowBox[{"hitTimes", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", 
         RowBox[{
          RowBox[{"Length", "[", "hitTimes", "]"}], "-", "1"}]}], "}"}]}], 
      "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"xs", "=", 
     RowBox[{"points", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    
    RowBox[{"pitches", "=", 
     RowBox[{"Floor", "/@", "xs"}]}], ";", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"audio", "=", 
     RowBox[{"Audio", "@", 
      RowBox[{"Sound", "@", 
       RowBox[{"Flatten", "@", 
        RowBox[{"Append", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"SoundNote", "[", 
            RowBox[{"None", ",", 
             RowBox[{"hitTimes", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"SoundNote", "@@@", 
             RowBox[{"Thread", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Most", "[", "pitches", "]"}], ",", "durations", ",", 
                "instrument"}], "}"}], "]"}]}], ",", "\[IndentingNewLine]", 
            RowBox[{"SoundNote", "[", 
             RowBox[{
              RowBox[{"Last", "[", "pitches", "]"}], ",", "1", ",", 
              "instrument"}], "]"}]}], "}"}]}], "]"}]}]}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"AudioPlay", "[", "audio", "]"}], ";", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"Animate", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Show", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Plot3D", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"Floor", "[", 
            RowBox[{"numSteps", "+", "1", "-", "x"}], "]"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "0", ",", 
            RowBox[{"runtime", "*", "velocityi"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"y", ",", "0", ",", "1"}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"PlotRange", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", 
               RowBox[{"runtime", "*", "velocityi"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", "1"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", 
               RowBox[{"heighti", "*", "1.1"}]}], "}"}]}], "}"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"PlotStyle", "->", "White"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Filling", "->", "Bottom"}], ",", 
          RowBox[{"Exclusions", "->", "None"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Axes", "->", "False"}], ",", 
          RowBox[{"Mesh", "->", "True"}], ",", 
          RowBox[{"MeshFunctions", "->", 
           RowBox[{"(", 
            RowBox[{"#3", "&"}], ")"}]}], ",", 
          RowBox[{"PlotPoints", "->", 
           RowBox[{"ControlActive", "[", 
            RowBox[{"20", ",", "40"}], "]"}]}], ",", 
          RowBox[{"MaxRecursion", "->", 
           RowBox[{"ControlActive", "[", 
            RowBox[{"2", ",", "4"}], "]"}]}], ",", 
          RowBox[{"Boxed", "->", "False"}]}], "\[IndentingNewLine]", "]"}], 
        ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"Graphics3D", "[", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"Blue", ",", 
           RowBox[{"PointSize", "[", "0.025", "]"}], ",", 
           RowBox[{"Point", "[", 
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"ballsteps", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], "[", "t", 
               "]"}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"ballsteps", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "2", ",", "2"}], "]"}], "]"}], "[", "t", 
               "]"}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{"ballsteps", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", "3", ",", "2"}], "]"}], "]"}], "[", "t", 
                "]"}], "+", "0.025"}]}], "}"}], "]"}]}], "}"}], 
         "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "runtime"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"AnimationRate", "->", "1"}], ",", "\[IndentingNewLine]", 
      RowBox[{"SaveDefinitions", "->", "True"}], ",", "\[IndentingNewLine]", 
      RowBox[{"AnimationRepetitions", "->", "1"}]}], "\[IndentingNewLine]", 
     "]"}]}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.9295476668167076`*^9, 3.9295476692050877`*^9}, {
   3.929607317673195*^9, 3.929607324027048*^9}, 3.929608199587902*^9, {
   3.929609253078314*^9, 3.9296092551987267`*^9}, {3.929609368050049*^9, 
   3.929609369501837*^9}, {3.9296322339252567`*^9, 3.9296322343915*^9}, {
   3.929696355490553*^9, 3.9296963658211994`*^9}, {3.929703632569908*^9, 
   3.929703637875107*^9}, 
   3.929709407494144*^9},ExpressionUUID->"333ed4d3-2a91-0642-924c-\
b564569074fb"]
}, Closed]],

Cell[CellGroupData[{

Cell["Adding a start/reset button", "Subsection",
 CellChangeTimes->{{3.929543793853796*^9, 3.929543802385123*^9}, {
  3.929573026819372*^9, 3.92957302725096*^9}, {3.929607299392685*^9, 
  3.929607300753216*^9}},ExpressionUUID->"63d73fd2-90f3-5146-bd05-\
fde7ebf8aa83"],

Cell[TextData[{
 "We can add buttons that control the animation playback using ",
 Cell[BoxData[
  StyleBox["Button",
   FontWeight->"Bold"]], "InlineCode",ExpressionUUID->
  "49e39621-fcad-d94a-a391-8bff87ea582a"],
 ". We introduce a new variable ",
 Cell[BoxData[
  StyleBox["running", "Code"]], "InlineCode",ExpressionUUID->
  "7c7bb105-37cb-4c4f-a103-b2243808023e"],
 ", which is ",
 Cell[BoxData[
  StyleBox["True",
   FontWeight->"Bold"]], "InlineCode",ExpressionUUID->
  "4750e731-4390-834b-a858-1dd638967aa5"],
 " when the animation is running and ",
 Cell[BoxData[
  StyleBox["False", "Code"]], "InlineCode",ExpressionUUID->
  "491baf43-67ed-b24b-adbb-a6b7ba9b2f88"],
 " when it is not. When the start button is pressed, ",
 Cell[BoxData[
  StyleBox["running",
   FontWeight->"Bold"]], "InlineCode",ExpressionUUID->
  "5abaa6cf-10e6-1349-a1fd-150b886f0ab9"],
 " is changed to ",
 Cell[BoxData[
  StyleBox["True",
   FontWeight->"Bold"]], "InlineCode",ExpressionUUID->
  "64a19504-9d45-d149-a414-bb65a1e2da63"],
 ". When the reset button is pressed, the audio stops playing and ",
 Cell[BoxData[
  StyleBox["running",
   FontWeight->"Bold"]], "InlineCode",ExpressionUUID->
  "c2d371e9-ab2c-854d-b279-627b14677d65"],
 " is set to ",
 Cell[BoxData[
  StyleBox["False", "Code"]], "InlineCode",ExpressionUUID->
  "50f7ae8f-a144-8141-90f6-04c3a3409c46"],
 "."
}], "Text",
 CellChangeTimes->{{3.9295477192681427`*^9, 3.929547751168019*^9}, {
  3.9295478057880936`*^9, 3.929547853345658*^9}, {3.92954802257914*^9, 
  3.9295480893542967`*^9}, {3.929573029576477*^9, 3.9295730299339943`*^9}, {
  3.929630043645275*^9, 3.929630047432228*^9}, {3.929659990933534*^9, 
  3.9296599969214077`*^9}},ExpressionUUID->"9537b2ef-055c-5d4a-b4c6-\
dcced5459142"],

Cell["Start button:", "CodeText",
 CellChangeTimes->{{3.929547875397196*^9, 3.9295478946575356`*^9}, {
  3.929572970079237*^9, 
  3.929572972590349*^9}},ExpressionUUID->"80dff6d6-473d-9040-ac09-\
0ce769397678"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Button", "[", 
  RowBox[{"\"\<Run Animation\>\"", ",", 
   RowBox[{
    RowBox[{"running", "=", "True"}], ";"}]}], "]"}]], "Code",
 InitializationCell->False,
 CellChangeTimes->{{3.9295729789364014`*^9, 3.9295730118930073`*^9}, {
  3.929573070002466*^9, 3.929573071580471*^9}},
 CellLabel->"In[21]:=",ExpressionUUID->"ee7b73ea-6dc6-3b49-b5d4-c96569a834ff"],

Cell[BoxData[
 ButtonBox["\<\"Run Animation\"\>",
  Appearance->Automatic,
  ButtonFunction:>($CellContext`running = True; Null),
  Evaluator->Automatic,
  Method->"Preemptive"]], "Output",
 CellChangeTimes->{3.929703809180071*^9, 3.929709577613396*^9, 
  3.9297097270805225`*^9},
 CellLabel->"Out[21]=",ExpressionUUID->"0440bf15-e45c-6241-9773-a0d26620082b"]
}, Open  ]],

Cell["Reset button:", "CodeText",
 CellChangeTimes->{{3.929573023401005*^9, 
  3.929573039354643*^9}},ExpressionUUID->"5ae15999-69e1-0749-baa3-\
7e81a1fb7a87"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Button", "[", 
  RowBox[{"\"\<Reset\>\"", ",", 
   RowBox[{
    RowBox[{"AudioStop", "[", "]"}], ";", 
    RowBox[{"running", "=", "False"}], ";"}]}], "]"}]], "Code",
 InitializationCell->False,
 CellChangeTimes->{{3.92957304310421*^9, 3.929573074703953*^9}},
 CellLabel->"In[22]:=",ExpressionUUID->"6e9483a3-1090-f14c-bc83-9b4c8b649d12"],

Cell[BoxData[
 ButtonBox["\<\"Reset\"\>",
  Appearance->Automatic,
  ButtonFunction:>(AudioStop[]; $CellContext`running = False; Null),
  Evaluator->Automatic,
  Method->"Preemptive"]], "Output",
 CellChangeTimes->{3.929703813100992*^9, 3.929709577857302*^9, 
  3.929709727250927*^9},
 CellLabel->"Out[22]=",ExpressionUUID->"212c665e-c1c4-974d-b857-1e89d93468d8"]
}, Open  ]],


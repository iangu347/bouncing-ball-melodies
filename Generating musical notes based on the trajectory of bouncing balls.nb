Cell[CellGroupData[{

Cell["Animating the plot", "Subsection",
 CellChangeTimes->{{3.929536843267674*^9, 
  3.929536846909519*^9}},ExpressionUUID->"f429e52b-dfb5-7248-a1f3-\
86720450ca78"],

Cell[TextData[{
 "We can now use the ",
 Cell[BoxData[
  StyleBox["Animate",
   FontWeight->"Bold"]], "InlineCode",ExpressionUUID->
  "4e687442-e1e7-ab46-9cd8-d2f03b92a79e"],
 " function to simulate the movement of the ball on the staircase from t=0 to \
",
 Cell[BoxData[
  StyleBox["runtime",
   FontWeight->"Bold"]], "InlineCode",ExpressionUUID->
  "ce060ff9-a966-6e4f-9ab9-4bc49ae8558d"],
 "."
}], "Text",
 CellChangeTimes->{{3.929536855452692*^9, 3.929536877642733*^9}, {
  3.929659729697377*^9, 3.929659752099053*^9}, {3.9297126712390327`*^9, 
  3.9297126733110867`*^9}},ExpressionUUID->"7fe9a0e9-c0bc-bb4a-afbe-\
1c34903bbbea"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Animate", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Show", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Plot3D", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Floor", "[", 
          RowBox[{"numSteps", "+", "1", "-", "x"}], "]"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "0", ",", 
          RowBox[{"runtime", "*", "velocityi"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"y", ",", "0", ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"PlotRange", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"runtime", "*", "velocityi"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", 

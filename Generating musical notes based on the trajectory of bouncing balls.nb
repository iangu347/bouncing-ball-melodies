Cell[TextData[{
 "To do this, we update the ",
 Cell[BoxData[
  StyleBox["NDSolve",
   FontWeight->"Bold"]], "InlineCode",ExpressionUUID->
  "bf4a302d-7b21-114b-8d43-e3d8bc1daa34"],
 " by setting y\[CloseCurlyQuote](0) = 0.2 and having the y-velocity to be \
negated after each bounce. "
}], "Text",
 CellChangeTimes->{{3.929627897507004*^9, 3.929627915769884*^9}, {
  3.9297128307256985`*^9, 3.929712835049881*^9}, {3.9297128703247986`*^9, 
  3.929712874943224*^9}},ExpressionUUID->"bf66f133-4fe1-034d-a6ba-\
94bcca86cecf"],

Cell[TextData[{
 "Updated ",
 Cell[BoxData[
  StyleBox["NDSolve",
   FontWeight->"Bold"]], "InlineCode",ExpressionUUID->
  "8693681e-a7dc-e34a-b3a3-8e325b38717e"],
 ":\n(a temporary value for ",
 Cell[BoxData[
  StyleBox["i",
   FontWeight->"Bold"]], "InlineCode",ExpressionUUID->
  "9365d6ee-977a-d849-981a-f8d78df53f95"],
 " and ",
 Cell[BoxData[
  StyleBox["numBalls",
   FontWeight->"Bold"]], "InlineCode",ExpressionUUID->
  "82d8a288-f84e-c949-b31a-fcff1f9f024c"],
 " is defined and then cleared for the code to run)"
}], "CodeText",
 CellChangeTimes->{{3.929615154843842*^9, 3.929615162970684*^9}, {
  3.929709104094242*^9, 

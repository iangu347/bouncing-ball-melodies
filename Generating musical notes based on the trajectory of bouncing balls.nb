Cell[CellGroupData[{

Cell["Adding the ball", "Subsection",
 CellChangeTimes->{{3.929536808115731*^9, 3.929536809397475*^9}, {
  3.92962991678581*^9, 
  3.929629920209511*^9}},ExpressionUUID->"1ba9f164-f97e-794a-9ed9-\
0c533ce00097"],

Cell[TextData[{
 "Using ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Graphics3D",
    FontWeight->"Bold"], ","}]], "InlineCode",
  FontWeight->"Plain",ExpressionUUID->"25ceb444-de09-0f45-9029-76ef61a9917e"],
 "we create a point that is centered at the position of the ball. We can use ",
 Cell[BoxData[
  StyleBox["ballsteps",
   FontWeight->"Bold"]], "InlineCode",ExpressionUUID->
  "992904c4-6343-ae47-ab58-a7893ae1b3cd"],
 " to get the position of the ball at any time ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["t", "TI"], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> "t.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9b28b60e-f156-de46-ac46-9dd0bbdc0e58"],
 " "
}], "Text",
 CellChangeTimes->{{3.9295362649431915`*^9, 3.929536266603689*^9}, {
  3.929536323305361*^9, 
  3.929536453963901*^9}},ExpressionUUID->"b8869c2a-bbf0-3748-b228-\
ef19408255ae"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Graphics3D", "[", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"Blue", ",", 
     RowBox[{"PointSize", "[", "0.025", "]"}], ",", 
     RowBox[{"Point", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"ballsteps", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], "[", "t", "]"}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"ballsteps", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "2", ",", "2"}], "]"}], "]"}], "[", "t", "]"}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"ballsteps", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "3", ",", "2"}], "]"}], "]"}], "[", "t", "]"}], 
         "+", "0.025"}]}], "}"}], "]"}]}], "}"}], "\[IndentingNewLine]", 
   "]"}], ";"}]], "Code",
 InitializationCell->False,
 CellChangeTimes->{{3.9295364631395226`*^9, 3.929536474261675*^9}, 
   3.9296467224297867`*^9, {3.929703268226837*^9, 3.929703269016657*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"8e541d3e-8a83-4c4a-b064-7bcf10647aca"],

Cell[TextData[{
 "We use ",
 Cell[BoxData[
  StyleBox["Show",
   FontWeight->"Bold"]], "InlineCode",ExpressionUUID->
  "4eaf551a-35b9-5747-bc8c-e1fadf219186"],
 " to display both the staircase and ball simultaneously."
}], "Text",
 CellChangeTimes->{{3.929536652014229*^9, 3.929536699848039*^9}, {
  3.929659445849516*^9, 
  3.929659446243437*^9}},ExpressionUUID->"e10f3a26-6218-c647-aa9e-\
52c3067030c6"],

Cell["Running the following code displays the animation at t=0:", "CodeText",
 CellChangeTimes->{{3.9297033411318455`*^9, 3.929703361853569*^9}, {
  3.9297125386555653`*^9, 3.9297125422382545`*^9}, {3.9297125820314484`*^9, 
  3.929712583500763*^9}},ExpressionUUID->"6d76eb1f-e0ea-a342-9ce6-\
712037dd5219"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Plot3D", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Floor", "[", 
       RowBox[{"numSteps", "+", "1", "-", "x"}], "]"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", 
       RowBox[{"runtime", "*", "velocityi"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", "0", ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"runtime", "*", "velocityi"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"heighti", "*", "1.1"}]}], "}"}]}], "}"}]}], " ", ",", 
     "\[IndentingNewLine]", 
     RowBox[{"PlotStyle", "->", "White"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Filling", "->", "Bottom"}], ",", 
     RowBox[{"Exclusions", "->", "None"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Axes", "->", "False"}], ",", 
     RowBox[{"Mesh", "->", "True"}], ",", 
     RowBox[{"MeshFunctions", "->", 
      RowBox[{"(", 
       RowBox[{"#3", "&"}], ")"}]}], ",", 
     RowBox[{"PlotPoints", "->", 
      RowBox[{"ControlActive", "[", 
       RowBox[{"20", ",", "40"}], "]"}]}], ",", 
     RowBox[{"MaxRecursion", "->", 
      RowBox[{"ControlActive", "[", 
       RowBox[{"2", ",", "4"}], "]"}]}], ",", 
     RowBox[{"Boxed", "->", "False"}]}], "\[IndentingNewLine]", "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"Graphics3D", "[", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"Blue", ",", 
      RowBox[{"PointSize", "[", "0.025", "]"}], ",", 
      RowBox[{"Point", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"ballsteps", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], "[", "0", "]"}], 
         ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"ballsteps", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "2", ",", "2"}], "]"}], "]"}], "[", "0", "]"}], 
         ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"ballsteps", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "3", ",", "2"}], "]"}], "]"}], "[", "0", "]"}],
           "+", "0.025"}]}], "}"}], "]"}]}], "}"}], "\[IndentingNewLine]", 
    "]"}]}], "\[IndentingNewLine]", "]"}]], "Code",
 InitializationCell->False,
 CellChangeTimes->{{3.929536741901009*^9, 3.929536751493206*^9}, {
   3.9295369764378376`*^9, 3.92953698286709*^9}, {3.929542850649328*^9, 

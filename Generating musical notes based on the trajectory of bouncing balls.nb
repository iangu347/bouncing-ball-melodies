Cell[TextData[{
 "The list ",
 Cell[BoxData[
  StyleBox["points",
   FontWeight->"Bold"]], "InlineCode",ExpressionUUID->
  "febdd24d-5953-1b43-9687-aee948fe305b"],
 " stores the intersection points between the ball\[CloseCurlyQuote]s \
trajectory and the staircase and the times of intersection in the form ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"{", 
           RowBox[{
             StyleBox["x", "TI"], ",", 
             StyleBox["y", "TI"], ",", 
             StyleBox["z", "TI"], ",", 
             StyleBox["t", "TI"]}], "}"}], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\{x,y,z,t\\}.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bde84825-2826-8344-bb17-cb632b527625"]
}], "CodeText",
 CellChangeTimes->{{3.929530349238535*^9, 3.9295304720480576`*^9}, {

Cell[CellGroupData[{

Cell["Playing the sound", "Section",
 CellChangeTimes->{{3.929286540988388*^9, 
  3.9292865557922916`*^9}},ExpressionUUID->"5b6a7bbd-8254-fd4e-9e1f-\
2fe4c9bd0632"],

Cell[TextData[{
 "Now that we have the animation, we need to play synchronized audio whenever \
the ball bounces. The list ",
 Cell[BoxData[
  StyleBox["points",
   FontWeight->"Bold"]], "InlineCode",ExpressionUUID->
  "a3f4d4b4-3f92-2245-9b73-c9c129dc7323"],
 " contains the positions and times in which the balls come in contact with \
the staircase in the form {x, y, z, t}. We extract the fourth element of each \
element in ",
 Cell[BoxData[
  StyleBox["points",
   FontWeight->"Bold"]], "InlineCode",ExpressionUUID->
  "1e86ff0e-59c2-a34d-bfca-044f6bfb0ec6"],
 " and store these times into a list:"
}], "Text",
 CellChangeTimes->{{3.929537447666716*^9, 3.929537502660602*^9}, {
  3.929538018297093*^9, 3.9295380474848843`*^9}, {3.9295382941016808`*^9, 
  3.929538302575547*^9}, {3.929538416891905*^9, 3.929538426839885*^9}, {
  3.929572801716833*^9, 3.929572819211693*^9}, {3.929624255418234*^9, 
  3.929624350387879*^9}, {3.929659784153761*^9, 3.929659835791677*^9}, {
  3.929712692739107*^9, 3.929712700064636*^9}, {3.929712750658024*^9, 
  3.929712762604233*^9}},ExpressionUUID->"5ba60801-a8c5-4147-9f40-\
6a3252447a3b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"hitTimes", "=", 
  RowBox[{"points", "[", 
   RowBox[{"[", 
    RowBox[{"All", ",", "4"}], "]"}], "]"}]}]], "Code",
 InitializationCell->False,
 CellChangeTimes->{{3.929538307621958*^9, 3.9295383090426197`*^9}, {
  3.929538405937937*^9, 3.929538410415104*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"0c454e15-8996-3e4e-b1a2-47792df8937f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "0.4515236395466663`", ",", "1.4653578456897902`", ",", 
   "2.721139134739741`", ",", "4.141038626965545`", ",", "5.680596453144995`",
    ",", "7.185379624821599`", ",", "8.539684479324963`", ",", 
   "9.75855884837797`"}], "}"}]], "Output",
 CellChangeTimes->{3.929538412246132*^9, 3.929709574202566*^9, 
  3.9297097246310616`*^9},
 CellLabel->"Out[16]=",ExpressionUUID->"7b0b99c5-9c93-c94a-994a-62509c94c297"]
}, Open  ]],

Cell["\<\
We run the following code to get the times between each bounce, in other \
words, the durations of the notes.\
\>", "Text",
 CellChangeTimes->{{3.929538460501156*^9, 
  3.929538498403684*^9}},ExpressionUUID->"bcc5686f-d7d3-e349-9292-\
42eb586cefef"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"durations", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"hitTimes", "[", 
      RowBox[{"[", 
       RowBox[{"i", "+", "1"}], "]"}], "]"}], "-", 
     RowBox[{"hitTimes", "[", 
      RowBox[{"[", "i", "]"}], "]"}]}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"i", ",", " ", 
      RowBox[{
       RowBox[{"Length", "[", "hitTimes", "]"}], "-", "1"}]}], "}"}]}], 
   "]"}]}]], "Code",
 InitializationCell->False,
 CellChangeTimes->{3.929538518420267*^9},
 CellLabel->"In[17]:=",ExpressionUUID->"90cd9cc4-4a77-f342-828a-e6baaffa8dca"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "1.013834206143124`", ",", "1.255781289049951`", ",", "1.4198994922258041`",
    ",", "1.5395578261794496`", ",", "1.5047831716766042`", ",", 
   "1.354304854503364`", ",", "1.2188743690530064`"}], "}"}]], "Output",
 CellChangeTimes->{3.92953851871463*^9, 3.929709574391115*^9, 
  3.9297097248106117`*^9},
 CellLabel->"Out[17]=",ExpressionUUID->"2d0e1a97-a545-7b47-9523-c85faf98c0d8"]
}, Open  ]],

Cell["\<\
Now we must get the pitches of the notes based on the x-coordinate of the \
ball. In Mathematica, 0 represents the middle-C pitch, and an integer n \
represents a pitch n semitones away from the middle-C. We store the \
x-coordinates into a list, then take the floor of each coordinate to get the \
pitches.\
\>", "Text",
 CellChangeTimes->{{3.929538598776779*^9, 3.929538599534132*^9}, {
  3.9295386530521603`*^9, 3.929538656315935*^9}, {3.929538763039894*^9, 
  3.929538784688114*^9}, {3.929538824690647*^9, 3.929538928094105*^9}, {
  3.929659869808262*^9, 3.929659882584076*^9}, {3.9297127906990376`*^9, 
  3.929712797267178*^9}},ExpressionUUID->"0cd27087-cf32-064a-a6cb-\
148a8e33d2ee"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"xs", "=", 
  RowBox[{"points", "[", 
   RowBox[{"[", 
    RowBox[{"All", ",", "1"}], "]"}], "]"}]}]], "Code",
 InitializationCell->False,
 CellChangeTimes->{
  3.9295388024801846`*^9, {3.929538934383183*^9, 3.9295389719332523`*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"1205c6af-bea4-7344-b021-2010fb90bb8f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "0.4515236395466663`", ",", "1.363974425075478`", ",", "2.381157269205935`",
    ",", "3.416263999038534`", ",", "4.426367888794855`", ",", 
   "5.314927303838173`", ",", "6.034660430020284`", ",", 
   "6.617644262227793`"}], "}"}]], "Output",
 CellChangeTimes->{
  3.92953880283959*^9, {3.929538956516379*^9, 3.9295389725742683`*^9}, 
   3.929709574610283*^9, 3.92970972499753*^9},
 CellLabel->"Out[18]=",ExpressionUUID->"3d16be38-8eae-ad4f-88b4-885499da16f1"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"pitches", "=", 
  RowBox[{"Floor", "/@", "xs"}]}]], "Code",
 InitializationCell->False,
 CellLabel->"In[19]:=",ExpressionUUID->"dba1b348-e38f-5e4a-bf5d-26425aea75b9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "0", ",", "1", ",", "2", ",", "3", ",", "4", ",", "5", ",", "6", ",", "6"}],
   "}"}]], "Output",
 CellChangeTimes->{3.9295389755283203`*^9, 3.9297095747925878`*^9, 
  3.9297097251855717`*^9},
 CellLabel->"Out[19]=",ExpressionUUID->"be39ea7a-442e-5a4a-8287-cb12a1a61b18"]
}, Open  ]],

Cell[TextData[{
 "Using ",
 Cell[BoxData[
  StyleBox["Sound",
   FontWeight->"Bold"]], "InlineCode",ExpressionUUID->
  "7c6d7585-c886-d04e-a712-015d6cf134a8"],
 " and ",
 Cell[BoxData[
  StyleBox["SoundNote",
   FontWeight->"Bold"]], "InlineCode",ExpressionUUID->
  "60ee539b-1be4-1c46-910b-ca40a5947774"],
 ", we now generate the synchronized audio. We account for the first and last \
notes using ",
 Cell[BoxData[
  RowBox[{
   StyleBox["Append",
    FontWeight->"Bold"], "."}]], "InlineCode",ExpressionUUID->
  "d80a4076-9c35-ae46-9f6b-0e9884913390"],
 " We use ",
 Cell[BoxData[
  StyleBox["Flatten",
   FontWeight->"Bold"]], "InlineCode",ExpressionUUID->
  "4ad7f873-a8e1-eb4d-ac8d-e1426653aae3"],
 " and ",
 Cell[BoxData[
  StyleBox["Thread",
   FontWeight->"Bold"]], "InlineCode",ExpressionUUID->
  "c4642174-a16b-d746-a262-5474428a21e5"],
 " to properly format the list for ",
 Cell[BoxData[
  StyleBox["Sound",
   FontWeight->"Bold"]], "InlineCode",ExpressionUUID->
  "b217fe90-793a-fd4c-a2aa-49b1bd915866"],
 ". Finally, we convert the sound into an ",
 Cell[BoxData[
  StyleBox["Audio",
   FontWeight->"Bold"]], "InlineCode",ExpressionUUID->
  "a2dbfd55-f2eb-fd43-ade8-e76f856b773f"],
 " for easier playback control."
}], "Text",
 CellChangeTimes->{{3.929539071888174*^9, 3.9295391200419426`*^9}, {
  3.929539215112046*^9, 3.929539241905895*^9}, {3.929539287606615*^9, 
  3.929539432933913*^9}, {3.9295416947896023`*^9, 3.929541695607506*^9}, {
  3.929541778312874*^9, 3.929541805825062*^9}, {3.929659901100778*^9, 
  3.929659911979719*^9}},ExpressionUUID->"9740d129-7e16-d74d-b3b0-\
536d792aef29"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"audio", "=", 
  RowBox[{"Audio", "@", 
   RowBox[{"Sound", "@", 
    RowBox[{"Flatten", "@", 
     RowBox[{"Append", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"SoundNote", "[", 
         RowBox[{"None", ",", 
          RowBox[{"hitTimes", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"SoundNote", "@@@", 
          RowBox[{"Thread", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Most", "[", "pitches", "]"}], ",", "durations"}], "}"}],
            "]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"SoundNote", "[", 
          RowBox[{
           RowBox[{"Last", "[", "pitches", "]"}], ",", "1"}], "]"}]}], 
        "}"}]}], "]"}]}]}]}]}]], "Code",
 InitializationCell->False,
 CellChangeTimes->{{3.929539126874288*^9, 3.929539141128313*^9}, {

Cell[CellGroupData[{

Cell["Implementing multiple balls", "Section",
 CellChangeTimes->{{3.9295224989790783`*^9, 3.9295225016772146`*^9}, {
  3.929609508931423*^9, 
  3.929609521996649*^9}},ExpressionUUID->"7d982b0f-49b3-8645-85c1-\
d868fcf778a7"],

Cell[TextData[{
 "Our next step is being to adjust the number of balls shown in the animation \
and produce sound that models this. We introduce a new parameter, ",
 Cell[BoxData[
  StyleBox["numBalls",
   FontWeight->"Bold"]], "InlineCode",ExpressionUUID->
  "bb76cdf3-5186-1542-8e95-b6d4e99a6b99"],
 ", representing the number of balls. The ",
 Cell[BoxData[
  StyleBox["Table",
   FontWeight->"Bold"]], "InlineCode",ExpressionUUID->
  "55ee3cc6-6e6d-3c4e-a82f-3983c7b0b604"],
 " function allows us to conveniently create multiple balls."
}], "Text",
 CellChangeTimes->{{3.929609891568039*^9, 3.9296099413943233`*^9}, {
  3.929610005474899*^9, 3.9296100652409954`*^9}, {3.9296127729319496`*^9, 
  3.9296127757112484`*^9}, {3.929613031631841*^9, 
  3.929613040359211*^9}},ExpressionUUID->"ee929025-c7e1-324e-8f45-\
4a9e602db3c4"],


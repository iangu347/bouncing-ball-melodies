Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"i", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"numBalls", "=", "2"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ballsteps", ",", 
     RowBox[{"{", "points", "}"}]}], "}"}], "=", 
   RowBox[{
    RowBox[{"NDSolve", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"x", "[", "0", "]"}], "==", "0"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"y", "[", "0", "]"}], "==", 
         RowBox[{"i", "/", 
          RowBox[{"(", 
           RowBox[{"numBalls", "+", "1"}], ")"}]}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"z", "[", "0", "]"}], "==", "heighti"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"x", "'"}], "[", "0", "]"}], "==", "velocityi"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"y", "'"}], "[", "0", "]"}], "==", "0.2"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"z", "'"}], "[", "0", "]"}], "==", "0"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"x", "''"}], "[", "t", "]"}], "==", "0"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"y", "''"}], "[", "t", "]"}], "==", "0"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"z", "''"}], "[", "t", "]"}], "==", 
         RowBox[{"-", "g"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"a", "[", "0", "]"}], "==", "numSteps"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"WhenEvent", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"Mod", "[", 
            RowBox[{
             RowBox[{"x", "[", "t", "]"}], ",", "1"}], "]"}], "==", "0"}], 
          ",", "\[IndentingNewLine]", 
          RowBox[{"If", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"a", "[", "t", "]"}], ">", "0"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"a", "[", "t", "]"}], "->", 
             RowBox[{
              RowBox[{"a", "[", "t", "]"}], "-", "1"}]}], ",", 
            "\[IndentingNewLine]", "\"\<RemoveEvent\>\""}], "]"}]}], "]"}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{"WhenEvent", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"z", "[", "t", "]"}], "==", 
            RowBox[{"a", "[", "t", "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"x", "'"}], "[", "t", "]"}], ",", 
               RowBox[{
                RowBox[{"y", "'"}], "[", "t", "]"}], ",", 
               RowBox[{
                RowBox[{"z", "'"}], "[", "t", "]"}]}], "}"}], "->", 
             RowBox[{"0.9", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"x", "'"}], "[", "t", "]"}], ",", 
                RowBox[{"-", 
                 RowBox[{
                  RowBox[{"y", "'"}], "[", "t", "]"}]}], ",", 
                RowBox[{"-", 
                 RowBox[{
                  RowBox[{"z", "'"}], "[", "t", "]"}]}]}], "}"}]}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Sow", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"x", "[", "t", "]"}], ",", 
               RowBox[{"y", "[", "t", "]"}], ",", 
               RowBox[{"z", "[", "t", "]"}], ",", "t"}], "}"}], "]"}]}], 
           "}"}]}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"x", ",", "y", ",", "z", ",", "a"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "runtime"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"DiscreteVariables", "->", 
       RowBox[{"{", "a", "}"}]}]}], "]"}], "//", "Reap"}]}], "\n"}], "\n", 
 RowBox[{"Clear", "[", 
  RowBox[{"i", ",", "numBalls"}], "]"}]}], "Code",
 InitializationCell->False,
